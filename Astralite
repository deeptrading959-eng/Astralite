		Position = UDim2.fromOffset(0, 46),
		Size = UDim2.new(0, sidebarWidth, 1, -46),
		BackgroundColor3 = Theme.Sidebar,
		BackgroundTransparency = 0.2,
		BorderSizePixel = 0,
		Parent = main,
	}, { Corner(12) })
	-- square off top and right corners
	Create("Frame", {
		Size = UDim2.new(1, 0, 0, 14),
		BackgroundColor3 = Theme.Sidebar,
		BackgroundTransparency = 0.2,
		BorderSizePixel = 0,
		Parent = sidebar,
	})
	Create("Frame", {
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, 0, 0, 14),
		Size = UDim2.new(0, 14, 1, -14),
		BackgroundColor3 = Theme.Sidebar,
		BackgroundTransparency = 0.2,
		BorderSizePixel = 0,
		Parent = sidebar,
	})
	Create("Frame", {
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, 0, 0, 0),
		Size = UDim2.new(0, 1, 1, 0),
		BackgroundColor3 = Theme.Stroke,
		BackgroundTransparency = 0.3,
		BorderSizePixel = 0,
		Parent = sidebar,
	})

	-- Flat tab list
	local tabList = Create("ScrollingFrame", {
		Name = "TabList",
		Size = UDim2.new(1, -1, 1, -72),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 0,
		CanvasSize = UDim2.new(0, 0, 0, 0),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		Parent = sidebar,
	}, { List(4), Padding(10, 10, 10, 10) })
	self.TabList = tabList

	-- Profile card
	local profile = Create("Frame", {
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 10, 1, -10),
		Size = UDim2.new(1, -21, 0, 52),
		BackgroundColor3 = Theme.Element,
		Parent = sidebar,
	}, { Corner(10), Stroke(Theme.Stroke, 1, 0.4) })
	local avatar = Create("ImageLabel", {
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 9, 0.5, 0),
		Size = UDim2.fromOffset(34, 34),
		BackgroundColor3 = Theme.Background,
		Image = "",
		Parent = profile,
	}, { Round(), Stroke(Theme.Accent, 1.5, 0.2) })
	Text({
		Text = LocalPlayer.DisplayName,
		Font = Theme.FontBold,
		TextSize = 13,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Position = UDim2.fromOffset(52, 9),
		Size = UDim2.new(1, -60, 0, 16),
		Parent = profile,
	})
	Text({
		Text = "@" .. LocalPlayer.Name,
		TextSize = 11,
		TextColor3 = Theme.SubText,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Position = UDim2.fromOffset(52, 26),
		Size = UDim2.new(1, -60, 0, 14),
		Parent = profile,
	})
	task.spawn(function()
		local ok, image = pcall(function()
			return Players:GetUserThumbnailAsync(LocalPlayer.UserId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size48x48)
		end)
		if ok and avatar.Parent then
			avatar.Image = image
		end
	end)

	-- Content area
	local content = Create("Frame", {
		Name = "Content",
		Position = UDim2.fromOffset(sidebarWidth, 46),
		Size = UDim2.new(1, -sidebarWidth, 1, -46),
		BackgroundTransparency = 1,
		Parent = main,
	})
	self.TitleLabel = Text({
		Text = "",
		Font = Theme.FontBold,
		TextSize = 15,
		Position = UDim2.fromOffset(18, 0),
		Size = UDim2.new(1, -36, 0, 44),
		Parent = content,
	})
	self.Pages = Create("Frame", {
		Name = "Pages",
		Position = UDim2.fromOffset(0, 44),
		Size = UDim2.new(1, 0, 1, -44),
		BackgroundTransparency = 1,
		ClipsDescendants = true,
		Parent = content,
	})

	-- Notifications
	self.NotifyHolder = Create("Frame", {
		Name = "Notifications",
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, -20, 1, -20),
		Size = UDim2.new(0, 290, 1, -40),
		BackgroundTransparency = 1,
		Parent = gui,
	}, {
		Create("UIListLayout", {
			Padding = UDim.new(0, 8),
			SortOrder = Enum.SortOrder.LayoutOrder,
			VerticalAlignment = Enum.VerticalAlignment.Bottom,
		}),
	})

	-- Close confirm dialog
	local overlay = Create("TextButton", {
		Name = "Overlay",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.new(0, 0, 0),
		BackgroundTransparency = 1,
		AutoButtonColor = false,
		Text = "",
		Visible = false,
		ZIndex = 20,
		Parent = main,
	})
	local dialog = Create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(320, 158),
		BackgroundColor3 = Theme.Sidebar,
		Parent = overlay,
	}, { Corner(12), Stroke(Theme.Accent, 1.5, 0.3) })
	local dialogScale = Create("UIScale", { Scale = 0.9, Parent = dialog })
	Text({
		Text = "Close the interface?",
		Font = Theme.FontBold,
		TextSize = 16,
		Position = UDim2.fromOffset(18, 16),
		Size = UDim2.new(1, -36, 0, 20),
		Parent = dialog,
	})
	Text({
		Text = "The UI will be removed. Run the script again to bring it back.",
		TextSize = 13,
		TextColor3 = Theme.SubText,
		TextWrapped = true,
		TextYAlignment = Enum.TextYAlignment.Top,
		Position = UDim2.fromOffset(18, 44),
		Size = UDim2.new(1, -36, 0, 40),
		Parent = dialog,
	})
	local function DialogButton(label, xScale, xOffset, primary)
		local btn = Create("TextButton", {
			AnchorPoint = Vector2.new(xScale, 1),
			Position = UDim2.new(xScale, xOffset, 1, -16),
			Size = UDim2.new(0.5, -24, 0, 34),
			BackgroundColor3 = primary and Theme.Danger or Theme.Element,
			AutoButtonColor = false,
			Text = label,
			Font = Theme.FontBold,
			TextSize = 13,
			TextColor3 = Theme.Text,
			Parent = dialog,
		}, { Corner(8) })
		if not primary then
			Stroke(Theme.Stroke, 1, 0.3).Parent = btn
			HoverColor(btn, Theme.Element, Theme.ElementHover)
		else
			HoverColor(btn, Theme.Danger, Color3.fromRGB(245, 95, 125))
		end
		return btn
	end
	local cancelBtn = DialogButton("Cancel", 0, 18, false)
	local confirmBtn = DialogButton("Close UI", 1, -18, true)

	local function ShowDialog(show)
		if show then
			overlay.Visible = true
			dialogScale.Scale = 0.9
			Tween(overlay, { BackgroundTransparency = 0.45 }, 0.2)
			Tween(dialogScale, { Scale = 1 }, 0.3, Enum.EasingStyle.Back)
		else
			Tween(overlay, { BackgroundTransparency = 1 }, 0.15)
			Tween(dialogScale, { Scale = 0.9 }, 0.15)
			task.delay(0.15, function() overlay.Visible = false end)
		end
	end

	minBtn.MouseButton1Click:Connect(function()
		self:SetMinimized(not self.Minimized)
	end)
	self.MinButton = minBtn
	self.TopDivider = topDivider

	closeBtn.MouseButton1Click:Connect(function()
		if self.Minimized then
			self:SetMinimized(false)
			task.wait(0.3)
		end
		ShowDialog(true)
	end)
	cancelBtn.MouseButton1Click:Connect(function() ShowDialog(false) end)
	confirmBtn.MouseButton1Click:Connect(function() self:Destroy() end)

	-- Dragging
	local dragging, dragStart, startPos = false, nil, nil
	topbar.InputBegan:Connect(function(input)
		if IsClick(input) then
			dragging = true
			dragStart = input.Position
			startPos = holder.Position
		end
	end)
	self:_connect(UserInputService.InputChanged, function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
			or input.UserInputType == Enum.UserInputType.Touch) then
			local delta = input.Position - dragStart
			holder.Position = UDim2.new(
				startPos.X.Scale, startPos.X.Offset + delta.X,
				startPos.Y.Scale, startPos.Y.Offset + delta.Y
			)
		end
	end)
	self:_connect(UserInputService.InputEnded, function(input)
		if IsClick(input) then dragging = false end
	end)

	-- Toggle key
	self:_connect(UserInputService.InputBegan, function(input, gameProcessed)
		if not gameProcessed and input.KeyCode == self.ToggleKey then
			self:SetVisible(not holder.Visible)
		end
		-- DEL always reopens the UI
		if not gameProcessed and input.KeyCode == Enum.KeyCode.Delete then
			self:SetVisible(true)
		end
	end)

	Tween(holderScale, { Scale = 1 }, 0.45, Enum.EasingStyle.Back)

	return self
end

function Window:_connect(signal, fn)
	local conn = signal:Connect(fn)
	table.insert(self.Connections, conn)
	return conn
end

function Window:SetVisible(visible)
	if visible then
		self.Holder.Visible = true
		self.HolderScale.Scale = 0.9
		Tween(self.HolderScale, { Scale = 1 }, 0.3, Enum.EasingStyle.Back)
	else
		local t = Tween(self.HolderScale, { Scale = 0.9 }, 0.15)
		t.Completed:Connect(function()
			if self.HolderScale.Scale <= 0.9 then
				self.Holder.Visible = false
			end
		end)
	end
end

function Window:SetMinimized(minimized)
	self.Minimized = minimized
	local height = minimized and 46 or self.Height
	Tween(self.Holder, { Size = UDim2.fromOffset(self.Width, height) }, 0.35)
	self.MinButton.Text = minimized and "+" or "-"
	self.TopDivider.Visible = not minimized
end

function Window:Destroy()
	-- hide instead of destroy so DEL can reopen it
	self:SetVisible(false)
end

-- Select a tab directly
function Window:Select(tab)
	if self.Current == tab then return end
	local old = self.Current
	if old then
		old.Frame.Visible = false
		old:SetActive(false)
	end
	self.Current = tab
	tab:SetActive(true)
	-- update header title
	local hex = Theme.AccentLight:ToHex()
	self.TitleLabel.Text = string.format('<font color="#%s">%s</font>', hex, tab.Name)
	self.TitleLabel.RichText = true
	tab.Frame.Visible = true
	tab.Frame.Position = UDim2.fromOffset(0, 14)
	Tween(tab.Frame, { Position = UDim2.fromOffset(0, 0) }, 0.35)
end

---------------------------------------------------------------------
-- Notifications
---------------------------------------------------------------------
function Window:Notify(config)
	config = config or {}
	local duration = config.Duration or 4

	local wrap = Create("Frame", {
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		Parent = self.NotifyHolder,
	})
	local card = Create("Frame", {
		Position = UDim2.new(1, 40, 0, 0),
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundColor3 = Theme.Sidebar,
		ClipsDescendants = true,
		Parent = wrap,
	}, { Corner(10), Stroke(Theme.Accent, 1, 0.35) })

	Create("Frame", {
		Position = UDim2.fromOffset(10, 12),
		Size = UDim2.new(0, 3, 1, -24),
		BackgroundColor3 = Color3.new(1, 1, 1),
		BorderSizePixel = 0,
		Parent = card,
	}, { Round(), AccentGradient(90) })

	local body = Create("Frame", {
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		Parent = card,
	}, { List(3), Padding(11, 15, 24, 14) })
	Text({
		Text = config.Title or "Notification",
		Font = Theme.FontBold,
		TextSize = 14,
		Size = UDim2.new(1, 0, 0, 18),
		LayoutOrder = 1,
		Parent = body,
	})
	Text({
		Text = config.Content or "",
		TextSize = 13,
		TextColor3 = Theme.SubText,
		TextWrapped = true,
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		LayoutOrder = 2,
		Parent = body,
	})

	local progress = Create("Frame", {
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 0, 1, 0),
		Size = UDim2.new(1, 0, 0, 3),
		BackgroundColor3 = Color3.new(1, 1, 1),
		BorderSizePixel = 0,
		Parent = card,
	}, { AccentGradient(0) })

	Tween(card, { Position = UDim2.new(0, 0, 0, 0) }, 0.45, Enum.EasingStyle.Quint)
	Tween(progress, { Size = UDim2.new(0, 0, 0, 3) }, duration, Enum.EasingStyle.Linear)

	task.delay(duration, function()
		if not card.Parent then return end
		local t = Tween(card, { Position = UDim2.new(1, 40, 0, 0) }, 0.35, Enum.EasingStyle.Quint, Enum.EasingDirection.In)
		t.Completed:Wait()
		wrap:Destroy()
	end)
end

