--[[
	Astralite UI - a purple Roblox interface library
	--------------------------------------------------------
	Put this in a LocalScript inside:
		StarterPlayer > StarterPlayerScripts
	(or StarterGui). Press Play.

	Features
		- Draggable window with soft purple glow
		- Flat tabs in a left sidebar (no sub-tabs, no dropdowns)
		- Minimize (top right) and Close with a confirm dialog
		- Toggle UI visibility with RightShift (rebindable in Settings)
		- Elements: Section, Label, Paragraph, Button, Toggle, Slider,
		  Textbox, Dropdown, Keybind, Color swatches
		- Toast notifications (bottom right)
		- Player profile card with avatar headshot

	API
		local Window = Library:CreateWindow({ Title = "Astralite", Subtitle = "Free" })
		local Tab    = Window:AddTab("Player")
		Tab:AddSection("Movement")
		Tab:AddToggle({ Name = "...", Default = false, Callback = function(v) end })
		Tab:AddSlider({ Name = "...", Min = 0, Max = 100, Default = 50, Increment = 1, Suffix = "", Callback = function(v) end })
		Window:Notify({ Title = "...", Content = "...", Duration = 4 })
]]

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local Lighting = game:GetService("Lighting")

local LocalPlayer = Players.LocalPlayer
local PlayerGui = LocalPlayer:WaitForChild("PlayerGui")

---------------------------------------------------------------------
-- Theme
---------------------------------------------------------------------
local Theme = {
	Background   = Color3.fromRGB(17, 13, 27),
	BackgroundHi = Color3.fromRGB(27, 19, 44),
	Sidebar      = Color3.fromRGB(22, 16, 36),
	Element      = Color3.fromRGB(31, 23, 50),
	ElementHover = Color3.fromRGB(41, 30, 66),
	Stroke       = Color3.fromRGB(62, 46, 96),
	Accent       = Color3.fromRGB(156, 92, 255),
	AccentLight  = Color3.fromRGB(205, 160, 255),
	AccentDark   = Color3.fromRGB(108, 52, 210),
	Text         = Color3.fromRGB(242, 237, 255),
	SubText      = Color3.fromRGB(160, 146, 192),
	Danger       = Color3.fromRGB(232, 72, 104),

	Font       = Enum.Font.Gotham,
	FontMedium = Enum.Font.GothamMedium,
	FontBold   = Enum.Font.GothamBold,
}

---------------------------------------------------------------------
-- Helpers
---------------------------------------------------------------------
local function Create(className, props, children)
	local inst = Instance.new(className)
	local parent
	for key, value in pairs(props or {}) do
		if key == "Parent" then
			parent = value
		else
			inst[key] = value
		end
	end
	for _, child in ipairs(children or {}) do
		child.Parent = inst
	end
	if parent then
		inst.Parent = parent
	end
	return inst
end

local function Corner(radius)
	return Create("UICorner", { CornerRadius = UDim.new(0, radius or 8) })
end

local function Round()
	return Create("UICorner", { CornerRadius = UDim.new(1, 0) })
end

local function Stroke(color, thickness, transparency)
	return Create("UIStroke", {
		Color = color or Theme.Stroke,
		Thickness = thickness or 1,
		Transparency = transparency or 0,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	})
end

local function Padding(top, bottom, left, right)
	return Create("UIPadding", {
		PaddingTop = UDim.new(0, top or 0),
		PaddingBottom = UDim.new(0, bottom or 0),
		PaddingLeft = UDim.new(0, left or 0),
		PaddingRight = UDim.new(0, right or 0),
	})
end

local function List(padding, direction)
	return Create("UIListLayout", {
		Padding = UDim.new(0, padding or 0),
		FillDirection = direction or Enum.FillDirection.Vertical,
		SortOrder = Enum.SortOrder.LayoutOrder,
	})
end

local function AccentGradient(rotation)
	return Create("UIGradient", {
		Color = ColorSequence.new(Theme.AccentLight, Theme.AccentDark),
		Rotation = rotation or 0,
	})
end

local function Tween(obj, props, time, style, direction)
	local tween = TweenService:Create(
		obj,
		TweenInfo.new(time or 0.25, style or Enum.EasingStyle.Quint, direction or Enum.EasingDirection.Out),
		props
	)
	tween:Play()
	return tween
end

local function Text(props)
	local base = {
		BackgroundTransparency = 1,
		Font = Theme.Font,
		TextColor3 = Theme.Text,
		TextSize = 14,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Center,
	}
	for k, v in pairs(props) do
		base[k] = v
	end
	return Create("TextLabel", base)
end

local function Fire(callback, ...)
	if callback then
		task.spawn(callback, ...)
	end
end

local function HoverColor(obj, normal, hover)
	obj.MouseEnter:Connect(function()
		Tween(obj, { BackgroundColor3 = hover }, 0.15)
	end)
	obj.MouseLeave:Connect(function()
		Tween(obj, { BackgroundColor3 = normal }, 0.15)
	end)
end

local function IsClick(input)
	return input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch
end

---------------------------------------------------------------------
-- Library
---------------------------------------------------------------------
local Library = {}

local Window = {}
Window.__index = Window

local Tab = {}
Tab.__index = Tab

