function Tab:_next()
	self.Order = self.Order + 1
	return self.Order
end

function Tab:_element(height, isButton)
	local el = Create(isButton and "TextButton" or "Frame", {
		Size = UDim2.new(1, 0, 0, height),
		BackgroundColor3 = Theme.Element,
		BorderSizePixel = 0,
		LayoutOrder = self:_next(),
		Parent = self.Frame,
	}, { Corner(8), Stroke(Theme.Stroke, 1, 0.45) })
	if isButton then
		el.Text = ""
		el.AutoButtonColor = false
	end
	-- register with current active section if any
	if self._activeSection then
		self._activeSection._register(el)
	end
	return el
end

local function ElementTitle(parent, text, width)
