end

---------------------------------------------------------------------
-- Dropdown
---------------------------------------------------------------------
function Tab:Dropdown(cfg)
	local opts = cfg.Options or {}
	local sel  = cfg.Default or opts[1]
	local open = false
	local el   = self:_el(42); el.ClipsDescendants=true

	local hdr = New("TextButton", { Size=UDim2.new(1,0,0,42), BackgroundTransparency=1,
		Text="", Parent=el })
	ElTitle(hdr, cfg.Name or "Dropdown", -196)
	local selLbl = Lbl({ Text=tostring(sel or "None"), Font=T.FontMd, TextSize=13,
		TextColor3=T.AccentLt, TextXAlignment=Enum.TextXAlignment.Right,
		TextTruncate=Enum.TextTruncate.AtEnd, AnchorPoint=Vector2.new(1,0),
		Position=UDim2.new(1,-36,0,0), Size=UDim2.new(0,150,1,0), Parent=hdr })
	local arrow = Lbl({ Text="›", Font=T.FontBd, TextSize=14, TextColor3=T.Sub,
		TextXAlignment=Enum.TextXAlignment.Center, AnchorPoint=Vector2.new(1,0.5),
		Position=UDim2.new(1,-12,0.5,0), Size=UDim2.fromOffset(16,16),
		Rotation=90, Parent=hdr })

	local list = New("Frame", { Position=UDim2.fromOffset(8,46), Size=UDim2.new(1,-16,0,0),
		AutomaticSize=Enum.AutomaticSize.Y, BackgroundTransparency=1, Parent=el }, { List(4) })
	local optBtns = {}

	local function openH() return 46 + #opts*32 + 4 end
	local function setOpen(v)
		open=v; Tw(el,{Size=UDim2.new(1,0,0,open and openH() or 42)},0.28)
		Tw(arrow,{Rotation=open and -90 or 90},0.22)
	end
	local function refresh()
		for opt,btn in pairs(optBtns) do
			local on = opt==sel
			Tw(btn,{BackgroundColor3=on and T.ElHover or T.Bg, TextColor3=on and T.Text or T.Sub},0.12)
		end
	end
	local function build()
		for _,b in pairs(optBtns) do b:Destroy() end; optBtns={}
		for i,opt in ipairs(opts) do
			local btn = New("TextButton", { Size=UDim2.new(1,0,0,28), BackgroundColor3=T.Bg,
				AutoButtonColor=false, Text=tostring(opt), Font=T.FontMd, TextSize=13,
				TextColor3=T.Sub, LayoutOrder=i, Parent=list }, { Corner(7) })
			btn.MouseEnter:Connect(function() if opt~=sel then Tw(btn,{TextColor3=T.Text},0.1) end end)
			btn.MouseLeave:Connect(function() if opt~=sel then Tw(btn,{TextColor3=T.Sub},0.1) end end)
			btn.MouseButton1Click:Connect(function()
				sel=opt; selLbl.Text=tostring(opt); refresh(); setOpen(false); Fire(cfg.Callback,opt)
			end)
			optBtns[opt]=btn
		end; refresh()
	end
	build()
	hdr.MouseButton1Click:Connect(function() setOpen(not open) end)
	hdr.MouseEnter:Connect(function() Tw(el,{BackgroundColor3=T.ElHover},0.12) end)
	hdr.MouseLeave:Connect(function() Tw(el,{BackgroundColor3=T.El},0.12) end)
	return {
		Set = function(_,o) sel=o; selLbl.Text=tostring(o); refresh(); Fire(cfg.Callback,o) end,
		Get = function() return sel end,
		Refresh = function(_,o) opts=o; build(); if open then setOpen(true) end end,
	}
end

---------------------------------------------------------------------
-- MultiSelect
---------------------------------------------------------------------
function Tab:MultiSelect(cfg)
	local opts  = cfg.Options or {}
	local sel   = {}
	if cfg.DefaultAll then for _,o in ipairs(opts) do sel[o]=true end end

	local ih, pad = 30, 4
	local listH  = #opts*(ih+pad)+pad
	local closedH, openH = 42, 42+listH+8
	local open = false

	local el = New("Frame", { Size=UDim2.new(1,0,0,closedH), BackgroundColor3=T.El,
		BorderSizePixel=0, ClipsDescendants=true, LayoutOrder=self:_next(), Parent=self.Frame },
		{ Corner(8), Stroke(T.Stroke,1,0.5) })
	if self._sec then self._sec:_reg(el) end

	local hdr = New("TextButton", { Size=UDim2.new(1,0,0,closedH), BackgroundTransparency=1,
		AutoButtonColor=false, Text="", Parent=el })
	ElTitle(hdr, cfg.Name or "Select", -32)
	local arrow = Lbl({ Text="/\\", Font=T.FontBd, TextSize=13, TextColor3=T.Sub,
		TextXAlignment=Enum.TextXAlignment.Center, AnchorPoint=Vector2.new(1,0.5),
		Position=UDim2.new(1,-12,0.5,0), Size=UDim2.fromOffset(16,16), Parent=hdr })

	local listF = New("Frame", { Position=UDim2.fromOffset(8,closedH), Size=UDim2.new(1,-16,0,listH),
		BackgroundTransparency=1, Parent=el }, { List(pad), Pad(0,pad,0,0) })

	local function renderAll()
		for _,c in ipairs(listF:GetChildren()) do
			if c:IsA("TextButton") then
				local on = sel[c.Name]==true
				Tw(c,{BackgroundColor3=on and T.Accent or T.El,
					TextColor3=on and T.Text or T.Sub,
					BackgroundTransparency=on and 0 or 0.55},0.14)
			end
		end
	end

	for i,opt in ipairs(opts) do
		local on = sel[opt]==true
		local btn = New("TextButton", { Name=opt, Size=UDim2.new(1,0,0,ih),
			BackgroundColor3=on and T.Accent or T.El,
			BackgroundTransparency=on and 0 or 0.55,
			AutoButtonColor=false, Text=opt, Font=T.FontMd, TextSize=13,
			TextColor3=on and T.Text or T.Sub, LayoutOrder=i, Parent=listF }, { Corner(6) })
		btn.MouseButton1Click:Connect(function()
			sel[opt]=not sel[opt]; renderAll(); Fire(cfg.Callback,opt,sel[opt],sel)
		end)
		btn.MouseEnter:Connect(function()
			if not sel[opt] then Tw(btn,{BackgroundTransparency=0.3,TextColor3=T.Text},0.1) end
		end)
		btn.MouseLeave:Connect(function()
			if not sel[opt] then Tw(btn,{BackgroundTransparency=0.55,TextColor3=T.Sub},0.1) end
		end)
	end

	hdr.MouseButton1Click:Connect(function()
		open=not open
		Tw(el,{Size=UDim2.new(1,0,0,open and openH or closedH)},0.28)
		arrow.Text = open and "\\/" or "/\\"
	end)
	hdr.MouseEnter:Connect(function() Tw(el,{BackgroundColor3=T.ElHover},0.12) end)
	hdr.MouseLeave:Connect(function() Tw(el,{BackgroundColor3=T.El},0.12) end)
	return {
		Get = function() return sel end,
		Set = function(_,o,v) sel[o]=v; renderAll() end,
	}
end

---------------------------------------------------------------------
-- Keybind
---------------------------------------------------------------------
function Tab:Keybind(cfg)
	local key  = cfg.Default or Enum.KeyCode.E
	local list = false
	local el   = self:_el(42)
	ElTitle(el, cfg.Name or "Keybind", -135)

	local chip = New("TextButton", { AnchorPoint=Vector2.new(1,0.5), Position=UDim2.new(1,-10,0.5,0),
		Size=UDim2.fromOffset(0,28), AutomaticSize=Enum.AutomaticSize.X,
		BackgroundColor3=T.Bg, AutoButtonColor=false, Text=key.Name,
		Font=T.FontBd, TextSize=12, TextColor3=T.AccentLt, Parent=el },
		{ Corner(7), Pad(0,0,12,12) })
	local cStr = Stroke(T.Stroke,1,0.2); cStr.Parent=chip

	chip.MouseButton1Click:Connect(function()
		list=true; chip.Text="…"; Tw(cStr,{Color=T.Accent,Transparency=0},0.14)
	end)
	self.Window:_on(UserInputService.InputBegan, function(i, gp)
		if list and i.UserInputType==Enum.UserInputType.Keyboard then
			list=false
			if i.KeyCode ~= Enum.KeyCode.Escape then key=i.KeyCode; Fire(cfg.Changed,key) end
			chip.Text=key.Name; Tw(cStr,{Color=T.Stroke,Transparency=0.2},0.14)
			return
		end
		if not gp and i.KeyCode==key then Fire(cfg.Callback,key) end
	end)
	return { Get=function() return key end }
end

---------------------------------------------------------------------
-- Colorpicker
---------------------------------------------------------------------
function Tab:Colorpicker(cfg)
	local colors = cfg.Colors or {
		Color3.fromRGB(148,82,255), Color3.fromRGB(230,90,180),
		Color3.fromRGB(80,135,255), Color3.fromRGB(60,205,165),
		Color3.fromRGB(255,175,75),
	}
	local idx = cfg.DefaultIndex or 1
	local el  = self:_el(44)
	ElTitle(el, cfg.Name or "Color", -(#colors*30+30))

	local row = New("Frame", { AnchorPoint=Vector2.new(1,0.5), Position=UDim2.new(1,-12,0.5,0),
		Size=UDim2.fromOffset(#colors*30,24), BackgroundTransparency=1, Parent=el },
		{ New("UIListLayout", { FillDirection=Enum.FillDirection.Horizontal,
			HorizontalAlignment=Enum.HorizontalAlignment.Right,
			VerticalAlignment=Enum.VerticalAlignment.Center,
			SortOrder=Enum.SortOrder.LayoutOrder, Padding=UDim.new(0,6) }) })

	local strokes = {}
	local function render()
		for i,s in ipairs(strokes) do Tw(s,{Transparency=i==idx and 0 or 1},0.14) end
	end
	for i,c in ipairs(colors) do
		local sw = New("TextButton", { Size=UDim2.fromOffset(22,22), BackgroundColor3=c,
			AutoButtonColor=false, Text="", LayoutOrder=i, Parent=row }, { Round() })
		local s  = Stroke(Color3.new(1,1,1),2,1); s.Parent=sw; strokes[i]=s
		sw.MouseButton1Click:Connect(function() idx=i; render(); Fire(cfg.Callback,c) end)
	end
	render()
	return { Get=function() return colors[idx] end }
end

