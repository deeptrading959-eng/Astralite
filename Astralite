local chestFarmState = {
	running = false,
}
-- proxy so running reflects farmThreads state
local function chestRunning()
	return farmThreads["chestfarm"] == true
end

local function doChestFarm()
	local system = workspace:FindFirstChild("Systems")
	local random = system and system:FindFirstChild("Random")
	if not random then task.wait(2) return end

	local chests = {}
	for _, desc in ipairs(random:GetDescendants()) do
		if desc:IsA("Model") and desc.Name == "Chest" then
			local owner = desc:GetAttribute("ChestOwnerUserId")
			if owner == nil or owner == 0 or owner == "" then
				local part = desc:FindFirstChildWhichIsA("BasePart")
				if part then
					table.insert(chests, { model = desc, pos = part.Position })
				end
			end
		end
	end

	if #chests == 0 then task.wait(2) return end

	table.sort(chests, function(a, b)
		return distFrom(a.pos) < distFrom(b.pos)
	end)

	for _, chest in ipairs(chests) do
		if not chestRunning() then return end
		local owner = chest.model.Parent and chest.model:GetAttribute("ChestOwnerUserId")
		if chest.model.Parent and (owner == nil or owner == 0 or owner == "") then
			-- move to chest and spam E immediately to fight anticheat
			moveTo(chest.pos, function() return chestRunning() end)
			if not chestRunning() then return end

			-- snapshot all drops within 50 studs right now
			local dropsFolder = workspace:FindFirstChild("Drops")
			if dropsFolder then
				local nearbyDrops = {}
				for _, drop in ipairs(dropsFolder:GetChildren()) do
					if drop:IsA("Model") then
						local p = drop:FindFirstChildWhichIsA("BasePart")
						if p and distFrom(p.Position) <= 50 then
							table.insert(nearbyDrops, { model = drop, pos = p.Position })
						end
					end
				end

				table.sort(nearbyDrops, function(a, b)
					return distFrom(a.pos) < distFrom(b.pos)
				end)

				for _, drop in ipairs(nearbyDrops) do
					if not chestRunning() then return end
					if drop.model.Parent then
						moveTo(drop.pos, function() return chestRunning() end)
						if not chestRunning() then return end
					end
				end
			end
		end
	end
	task.wait(1)
end

