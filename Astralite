function Tab:AddSection(title)
	-- track children added after this section header
	local sectionOrder = self:_next()
	local open = true
	local children = {}  -- { frame element }

	-- header button
	local holder = Create("TextButton", {
		Size = UDim2.new(1, 0, 0, 30),
		BackgroundTransparency = 1,
		AutoButtonColor = false,
		Text = "",
		LayoutOrder = sectionOrder,
		Parent = self.Frame,
	})

	Create("Frame", {
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 2, 1, -7),
		Size = UDim2.fromOffset(3, 14),
		BackgroundColor3 = Color3.new(1, 1, 1),
		BorderSizePixel = 0,
		Parent = holder,
	}, { Round(), AccentGradient(90) })

	Text({
		Text = title,
		Font = Theme.FontBold,
		TextSize = 13,
		TextColor3 = Theme.AccentLight,
		TextYAlignment = Enum.TextYAlignment.Bottom,
		Position = UDim2.fromOffset(12, 0),
		Size = UDim2.new(1, -30, 1, -6),
		Parent = holder,
	})

	local arrow = Text({
		Text = open and "\\/" or "/\\",
		Font = Theme.FontBold,
		TextSize = 14,
		TextColor3 = Theme.AccentLight,
		TextXAlignment = Enum.TextXAlignment.Center,
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, -8, 1, -6),
		Size = UDim2.fromOffset(16, 16),
		Parent = holder,
	})

	-- snapshot of current child count so we know which elements belong to this section
	local baseOrder = self.Order

	-- toggle visibility of children added after this header
	holder.MouseButton1Click:Connect(function()
		open = not open
		arrow.Text = open and "\\/" or "/\\"
		for _, el in ipairs(children) do
			el.Visible = open
		end
	end)

	-- wrap _element so newly created elements register themselves
	local origNext = self._next
	local section = {
		-- called by Tab elements to register as belonging to this section
		_register = function(el)
			table.insert(children, el)
		end,
	}

	-- store section reference so Tab:_element can auto-register
	self._activeSection = section

	return section
end

