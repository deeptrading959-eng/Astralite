function Tab:AddDropdown(config)
	local options = config.Options or {}
	local selected = config.Default or options[1]
	local open = false

	local el = self:_element(40)
	el.ClipsDescendants = true

	local header = Create("TextButton", {
		Size = UDim2.new(1, 0, 0, 40),
		BackgroundTransparency = 1,
		Text = "",
		Parent = el,
	})
	ElementTitle(header, config.Name or "Dropdown", -190)

	local selectedLabel = Text({
		Text = tostring(selected or "None"),
		Font = Theme.FontMedium,
		TextSize = 13,
		TextColor3 = Theme.AccentLight,
		TextXAlignment = Enum.TextXAlignment.Right,
		TextTruncate = Enum.TextTruncate.AtEnd,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -36, 0, 0),
		Size = UDim2.new(0, 150, 1, 0),
		Parent = header,
	})
	local arrow = Text({
		Text = ">",
		Font = Theme.FontBold,
		TextSize = 13,
		TextColor3 = Theme.SubText,
		TextXAlignment = Enum.TextXAlignment.Center,
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -12, 0.5, 0),
		Size = UDim2.fromOffset(16, 16),
		Rotation = 90,
		Parent = header,
	})

	local list = Create("Frame", {
		Position = UDim2.fromOffset(8, 44),
		Size = UDim2.new(1, -16, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		Parent = el,
	}, { List(4) })

	local optionButtons = {}

	local function openHeight()
		return 44 + #options * 32 + 4
	end

	local function setOpen(value)
		open = value
		Tween(el, { Size = UDim2.new(1, 0, 0, open and openHeight() or 40) }, 0.3)
		Tween(arrow, { Rotation = open and -90 or 90 }, 0.3)
	end

	local function refreshColors()
		for opt, btn in pairs(optionButtons) do
			local isSelected = opt == selected
			Tween(btn, {
				BackgroundColor3 = isSelected and Theme.ElementHover or Theme.Background,
				TextColor3 = isSelected and Theme.Text or Theme.SubText,
			}, 0.15)
		end
	end

	local function build()
		for _, btn in pairs(optionButtons) do btn:Destroy() end
		optionButtons = {}
		for i, opt in ipairs(options) do
			local btn = Create("TextButton", {
				Size = UDim2.new(1, 0, 0, 28),
				BackgroundColor3 = Theme.Background,
				AutoButtonColor = false,
				Text = tostring(opt),
				Font = Theme.FontMedium,
				TextSize = 13,
				TextColor3 = Theme.SubText,
				LayoutOrder = i,
				Parent = list,
			}, { Corner(6) })
			btn.MouseEnter:Connect(function()
				if opt ~= selected then Tween(btn, { TextColor3 = Theme.Text }, 0.1) end
			end)
			btn.MouseLeave:Connect(function()
				if opt ~= selected then Tween(btn, { TextColor3 = Theme.SubText }, 0.1) end
			end)
			btn.MouseButton1Click:Connect(function()
				selected = opt
				selectedLabel.Text = tostring(opt)
				refreshColors()
				setOpen(false)
				Fire(config.Callback, opt)
			end)
			optionButtons[opt] = btn
		end
		refreshColors()
	end
	build()

	header.MouseButton1Click:Connect(function() setOpen(not open) end)
	header.MouseEnter:Connect(function() Tween(el, { BackgroundColor3 = Theme.ElementHover }, 0.15) end)
	header.MouseLeave:Connect(function() Tween(el, { BackgroundColor3 = Theme.Element }, 0.15) end)

	return {
		Set = function(_, opt)
			selected = opt
			selectedLabel.Text = tostring(opt)
			refreshColors()
			Fire(config.Callback, opt)
		end,
		Get = function() return selected end,
		Refresh = function(_, newOptions)
			options = newOptions
			build()
			if open then setOpen(true) end
		end,
	}
end

-- Multi-select dropdown: toggleable open/close, brighter = on, darker = off
function Tab:AddMultiSelect(config)
	local options  = config.Options or {}
	local selected = {}
	if config.DefaultAll then
		for _, o in ipairs(options) do selected[o] = true end
	end

	local itemH   = 28
	local padding  = 4
	local listH    = #options * (itemH + padding) + padding
	local closedH  = 40
	local openH    = closedH + listH + 8

	local open = false

	-- outer card, clips so list hides when closed
	local el = Create("Frame", {
		Size = UDim2.new(1, 0, 0, closedH),
		BackgroundColor3 = Theme.Element,
		BorderSizePixel = 0,
		ClipsDescendants = true,
		LayoutOrder = self:_next(),
		Parent = self.Frame,
	}, { Corner(8), Stroke(Theme.Stroke, 1, 0.45) })
	if self._activeSection then self._activeSection._register(el) end

	-- header button
	local header = Create("TextButton", {
		Size = UDim2.new(1, 0, 0, closedH),
		BackgroundTransparency = 1,
		AutoButtonColor = false,
		Text = "",
		Parent = el,
	})
	ElementTitle(header, config.Name or "Select", -30)

	local arrow = Text({
		Text = "/\\",
		Font = Theme.FontBold,
		TextSize = 14,
		TextColor3 = Theme.SubText,
		TextXAlignment = Enum.TextXAlignment.Center,
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -12, 0.5, 0),
		Size = UDim2.fromOffset(16, 16),
		Parent = header,
	})

	-- list frame
	local listFrame = Create("Frame", {
		Position = UDim2.fromOffset(8, closedH),
		Size = UDim2.new(1, -16, 0, listH),
		BackgroundTransparency = 1,
		Parent = el,
	}, { List(padding), Padding(0, padding, 0, 0) })

	local function renderAll()
		for _, child in ipairs(listFrame:GetChildren()) do
			if child:IsA("TextButton") then
				local on = selected[child.Name] == true
				Tween(child, {
					BackgroundColor3       = on and Theme.Accent or Theme.Element,
					TextColor3             = on and Theme.Text   or Theme.SubText,
					BackgroundTransparency = on and 0            or 0.55,
				}, 0.15)
			end
		end
	end

	for i, opt in ipairs(options) do
		local on = selected[opt] == true
		local btn = Create("TextButton", {
			Name = opt,
			Size = UDim2.new(1, 0, 0, itemH),
			BackgroundColor3       = on and Theme.Accent or Theme.Element,
			BackgroundTransparency = on and 0            or 0.55,
			AutoButtonColor = false,
			Text = opt,
			Font = Theme.FontMedium,
			TextSize = 13,
			TextColor3 = on and Theme.Text or Theme.SubText,
			LayoutOrder = i,
			Parent = listFrame,
		}, { Corner(6) })

