local function startLoop(key, fn)
	if farmThreads[key] then return end
	farmThreads[key] = true
	task.spawn(function()
		while farmThreads[key] do
			local ok, err = pcall(fn)
			if not ok then
				print("[Astralite] " .. key .. " error:", tostring(err))
			end
			-- only wait if still running, so stop is near-instant
			if farmThreads[key] then
