-- tween the character using Humanoid:MoveTo with high speed


-- check if an NPC is too close to a position (avoid accidental E on them)
local function npcNearby(position, radius)
	local npcFolder = workspace:FindFirstChild("NPCs")
	local monFolder = workspace:FindFirstChild("Monsters")
	radius = radius or 12
	for _, folder in ipairs({ npcFolder, monFolder }) do
		if folder then
			for _, model in ipairs(folder:GetChildren()) do
				if model:IsA("Model") then
					local hrp = model:FindFirstChild("HumanoidRootPart")
						or model:FindFirstChildWhichIsA("BasePart")
					if hrp and (hrp.Position - position).Magnitude < radius then
						return true
					end
				end
			end
		end
	end
	return false
end

local function getBackpackCount()
	local bp = LocalPlayer:FindFirstChild("Backpack")
	local char = LocalPlayer.Character
	local count = 0
	if bp then
		for _, v in ipairs(bp:GetChildren()) do
			if v:IsA("Tool") then count = count + 1 end
		end
	end
	if char then
		for _, v in ipairs(char:GetChildren()) do
			if v:IsA("Tool") then count = count + 1 end
		end
	end
	return count
end

local function tweenToMerchant()
	local npcFolder = workspace:FindFirstChild("NPCs")
	if not npcFolder then return end
	local david = npcFolder:FindFirstChild("David, Merchant")
	if not david then
		Window:Notify({ Title = "AutoSell", Content = "David the Merchant not found in NPCs.", Duration = 4 })
		return
	end
	local part = david:FindFirstChildWhichIsA("BasePart")
	if not part then return end

	local char = LocalPlayer.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	if not hum or not hrp then return end

	local dest = part.Position + Vector3.new(4, 0, 0)
	local dist = (hrp.Position - dest).Magnitude
	local prevSpeed = hum.WalkSpeed
	hum.WalkSpeed = 100
	hum:MoveTo(dest)

	local timeout = dist / 100 + 3
	local elapsed = 0
	while elapsed < timeout do
		task.wait(0.1)
		elapsed = elapsed + 0.1
		if not farmThreads["dropfarm"] then
			hum.WalkSpeed = BypassState.SpeedValue
			return
		end
		if (hrp.Position - dest).Magnitude < 6 then break end
	end
	hum.WalkSpeed = BypassState.SpeedValue
end

local function doAutoSell()
	local bp = LocalPlayer:FindFirstChild("Backpack")
	if not bp then return end

	local toSell = {}
	for _, tool in ipairs(bp:GetChildren()) do
		if tool:IsA("Tool") then
			local rarityVal = tool:FindFirstChild("Rarity")
			local rarity = rarityVal and rarityVal.Value or tool:GetAttribute("Rarity") or "Common"
			if dropFarmState.sellRarities[rarity] then
				table.insert(toSell, { tool = tool, rarity = rarity })
			end
		end
	end

	if #toSell == 0 then return end

	table.sort(toSell, function(a, b)
		return (RARITY_ORDER[a.rarity] or 1) < (RARITY_ORDER[b.rarity] or 1)
	end)

	local sold = 0
	for _, entry in ipairs(toSell) do
		if not farmThreads["dropfarm"] then return end
		if entry.tool.Parent == bp then
			pcall(function() SellRemote:FireServer({entry.tool}) end)
			sold = sold + 1
			task.wait(0.25)
		end
	end

	Window:Notify({
		Title   = "AutoSell",
		Content = "Sold " .. sold .. " items. Returning to farm...",
		Duration = 4,
	})
end

local function doDropFarm()
	-- check bag full before farming
	local limit = dropFarmState.bagGamepass and 230 or 130
	if dropFarmState.autoSell and getBackpackCount() >= limit then
		Window:Notify({
			Title   = "Drop Farm",
			Content = "Bag full - heading to David the Merchant...",
			Duration = 4,
		})
		tweenToMerchant()
		if not farmThreads["dropfarm"] then return end
		task.wait(0.5)
		doAutoSell()
		task.wait(1)
		return
	end

	local dropsFolder = workspace:FindFirstChild("Drops")
	if not dropsFolder then task.wait(2) return end

	local targets = {}
	for _, drop in ipairs(dropsFolder:GetChildren()) do
		if drop:IsA("Model") then
			local rarity = drop:GetAttribute("Rarity") or "Common"
			if dropFarmState.rarities[rarity] then
				local part = drop:FindFirstChildWhichIsA("BasePart")
				if part then
					if not npcNearby(part.Position) then
						table.insert(targets, { model = drop, pos = part.Position })
					end
				end
			end
		end
	end

	if #targets == 0 then task.wait(1) return end

	table.sort(targets, function(a, b)
		return distFrom(a.pos) < distFrom(b.pos)
	end)

	local consecutiveFails = 0

	for _, t in ipairs(targets) do
		if not farmThreads["dropfarm"] then return end

		-- check bag mid-farm too
		local limit2 = dropFarmState.bagGamepass and 230 or 130
		if dropFarmState.autoSell and getBackpackCount() >= limit2 then
			Window:Notify({
				Title   = "Drop Farm",
				Content = "Bag full - heading to David the Merchant...",
				Duration = 4,
			})
			tweenToMerchant()
			if not farmThreads["dropfarm"] then return end
			task.wait(0.5)
			doAutoSell()
			task.wait(1)
			return
		end

		if t.model.Parent then
			if not npcNearby(t.pos) then
				local countBefore = getBackpackCount()
				local changed = false
				local deadline = tick() + 5
				local target = CFrame.new(t.pos + Vector3.new(0, 3, 0))

				local conn
				conn = RenderStepped:Connect(function()
					local c = LocalPlayer.Character
					if not c then return end
					local hum = c:FindFirstChildOfClass("Humanoid")
					if hum then hum.PlatformStand = true end
					c:PivotTo(target)
					if hum then hum.PlatformStand = false end
				end)

				while tick() < deadline do
					if not farmThreads["dropfarm"] then
						conn:Disconnect()
						return
					end
					if not t.model.Parent then break end
					if getBackpackCount() ~= countBefore then
						changed = true
						break
					end
					pressE()
					task.wait(0.05)
				end

				conn:Disconnect()

				if changed then
					consecutiveFails = 0
				else
					consecutiveFails = consecutiveFails + 1
					-- just skip, try next item
				end
			end
		end
	end
end

