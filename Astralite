--[[
	Astralite UI Library v2.0
	Universal Roblox UI Library
	
	Usage:
		local Astralite = loadstring(game:HttpGet("..."))()
		local Window = Astralite:CreateWindow({
			Title    = "My Script",
			Subtitle = "v1.0",
			Key      = Enum.KeyCode.RightShift,
		})
		local Tab = Window:Tab("Player")
		Tab:Section("Movement")
		Tab:Toggle({ Name = "Fly", Default = false, Callback = function(v) end })
		Tab:Slider({ Name = "Speed", Min = 16, Max = 250, Default = 16, Suffix = "", Callback = function(v) end })
		Tab:Button({ Name = "Kill Aura", Callback = function() end })
		Tab:Dropdown({ Name = "Team", Options = {"Red","Blue"}, Callback = function(v) end })
		Tab:MultiSelect({ Name = "Rarities", Options = {"Common","Rare"}, Callback = function(o,s) end })
		Tab:Keybind({ Name = "Toggle", Default = Enum.KeyCode.E, Callback = function() end })
		Tab:Textbox({ Name = "Name", Placeholder = "Enter...", Callback = function(t, enter) end })
		Tab:Colorpicker({ Name = "Color", Callback = function(c) end })
		Window:Notify({ Title = "Ready", Content = "Loaded.", Duration = 4 })
]]

local Players         = game:GetService("Players")
local TweenService    = game:GetService("TweenService")
local UserInputService= game:GetService("UserInputService")
local RunService      = game:GetService("RunService")

local LocalPlayer = Players.LocalPlayer
local PlayerGui   = LocalPlayer:WaitForChild("PlayerGui")

---------------------------------------------------------------------
-- Theme
---------------------------------------------------------------------
local T = {
	Bg       = Color3.fromRGB(14, 11, 22),
	BgHi     = Color3.fromRGB(22, 16, 36),
	Sidebar  = Color3.fromRGB(18, 13, 30),
	El       = Color3.fromRGB(28, 20, 46),
	ElHover  = Color3.fromRGB(38, 28, 60),
	Stroke   = Color3.fromRGB(55, 40, 88),
	Accent   = Color3.fromRGB(148, 82, 255),
	AccentLt = Color3.fromRGB(198, 152, 255),
	AccentDk = Color3.fromRGB(100, 45, 200),
	Text     = Color3.fromRGB(240, 235, 255),
	Sub      = Color3.fromRGB(148, 134, 180),
	Danger   = Color3.fromRGB(230, 65, 100),
	Font     = Enum.Font.Gotham,
	FontMd   = Enum.Font.GothamMedium,
	FontBd   = Enum.Font.GothamBold,
}

---------------------------------------------------------------------
-- Helpers
---------------------------------------------------------------------
local function New(class, props, children)
	local inst = Instance.new(class)
	local parent
	for k, v in pairs(props or {}) do
		if k == "Parent" then parent = v
		else inst[k] = v end
	end
	for _, c in ipairs(children or {}) do c.Parent = inst end
	if parent then inst.Parent = parent end
	return inst
end

local function Corner(r)  return New("UICorner",  { CornerRadius = UDim.new(0, r or 8) }) end
local function Round()    return New("UICorner",  { CornerRadius = UDim.new(1, 0) }) end
local function Stroke(c, t, tr)
	return New("UIStroke", { Color = c or T.Stroke, Thickness = t or 1,
		Transparency = tr or 0, ApplyStrokeMode = Enum.ApplyStrokeMode.Border })
end
local function Pad(t, b, l, r)
	return New("UIPadding", { PaddingTop = UDim.new(0,t or 0), PaddingBottom = UDim.new(0,b or 0),
		PaddingLeft = UDim.new(0,l or 0), PaddingRight = UDim.new(0,r or 0) })
end
local function List(p, d)
	return New("UIListLayout", { Padding = UDim.new(0,p or 0),
		FillDirection = d or Enum.FillDirection.Vertical, SortOrder = Enum.SortOrder.LayoutOrder })
end
local function Grad(c1, c2, rot)
	return New("UIGradient", { Color = ColorSequence.new(c1, c2), Rotation = rot or 0 })
end
local function AccentGrad(rot)
	return Grad(T.AccentLt, T.AccentDk, rot or 0)
end
local function Tw(obj, props, t, s, d)
	local tw = TweenService:Create(obj,
		TweenInfo.new(t or 0.22, s or Enum.EasingStyle.Quint, d or Enum.EasingDirection.Out), props)
	tw:Play(); return tw
end
local function Lbl(props)
	local base = { BackgroundTransparency=1, Font=T.Font, TextColor3=T.Text,
		TextSize=14, TextXAlignment=Enum.TextXAlignment.Left, TextYAlignment=Enum.TextYAlignment.Center }
	for k,v in pairs(props) do base[k]=v end
	return New("TextLabel", base)
end
local function Fire(fn, ...) if fn then task.spawn(fn, ...) end end
local function IsClick(i)
	return i.UserInputType == Enum.UserInputType.MouseButton1
		or i.UserInputType == Enum.UserInputType.Touch
end
local function HoverEl(el)
	el.MouseEnter:Connect(function() Tw(el, { BackgroundColor3 = T.ElHover }, 0.12) end)
	el.MouseLeave:Connect(function() Tw(el, { BackgroundColor3 = T.El }, 0.12) end)
end

