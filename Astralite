-- Button
---------------------------------------------------------------------
function Tab:Button(cfg)
	local el = self:_el(42, true)
	el.ClipsDescendants = true
	ElTitle(el, cfg.Name or "Button", -64)
	HoverEl(el)

	local icon = New("Frame", { AnchorPoint=Vector2.new(1,0.5), Position=UDim2.new(1,-10,0.5,0),
		Size=UDim2.fromOffset(24,24), BackgroundColor3=Color3.new(1,1,1), Parent=el },
		{ Corner(7), AccentGrad(45) })
	Lbl({ Text="›", Font=T.FontBd, TextSize=16, TextXAlignment=Enum.TextXAlignment.Center,
		Size=UDim2.fromScale(1,1), Parent=icon })

	el.InputBegan:Connect(function(i)
		if not IsClick(i) then return end
		local rip = New("Frame", { AnchorPoint=Vector2.new(0.5,0.5),
			Position=UDim2.fromOffset(i.Position.X-el.AbsolutePosition.X, i.Position.Y-el.AbsolutePosition.Y),
			Size=UDim2.fromOffset(0,0), BackgroundColor3=T.AccentLt,
			BackgroundTransparency=0.72, Parent=el }, { Round() })
		local sz = el.AbsoluteSize.X * 1.6
		local t = Tw(rip, { Size=UDim2.fromOffset(sz,sz), BackgroundTransparency=1 }, 0.55)
		t.Completed:Connect(function() rip:Destroy() end)
	end)
	el.MouseButton1Click:Connect(function() Fire(cfg.Callback) end)
end

---------------------------------------------------------------------
-- Toggle
---------------------------------------------------------------------
function Tab:Toggle(cfg)
	local state = cfg.Default == true
	local el = self:_el(42, true)
	ElTitle(el, cfg.Name or "Toggle", -78)
	HoverEl(el)

	local track = New("Frame", { AnchorPoint=Vector2.new(1,0.5), Position=UDim2.new(1,-12,0.5,0),
		Size=UDim2.fromOffset(44,23), BackgroundColor3=T.Stroke, Parent=el }, { Round() })
	local knob  = New("Frame", { AnchorPoint=Vector2.new(0,0.5), Position=UDim2.new(0,3,0.5,0),
		Size=UDim2.fromOffset(17,17), BackgroundColor3=T.Sub, Parent=track }, { Round() })

	local function render(t)
		Tw(track, { BackgroundColor3=state and T.Accent or T.Stroke }, t)
		Tw(knob,  { Position=state and UDim2.new(0,24,0.5,0) or UDim2.new(0,3,0.5,0),
			BackgroundColor3=state and Color3.new(1,1,1) or T.Sub }, t, Enum.EasingStyle.Back)
	end
	render(0)
	el.MouseButton1Click:Connect(function()
		state = not state; render(0.22); Fire(cfg.Callback, state)
	end)
	if state then Fire(cfg.Callback, state) end
	return {
		Set = function(_, v) state=v==true; render(0.22); Fire(cfg.Callback, state) end,
		Get = function() return state end,
	}
end

---------------------------------------------------------------------
-- Slider
---------------------------------------------------------------------
function Tab:Slider(cfg)
	local min = cfg.Min or 0; local max = cfg.Max or 100
	local inc = cfg.Increment or 1; local suf = cfg.Suffix or ""
	local val = math.clamp(cfg.Default or min, min, max)
	local dec = 0
	local dp  = tostring(inc):match("%.(%d+)$")
	if dp then dec = #dp end

	local el = self:_el(60)
	Lbl({ Text=cfg.Name or "Slider", Font=T.FontMd, TextSize=14,
		Position=UDim2.fromOffset(14,10), Size=UDim2.new(1,-110,0,18), Parent=el })
	local vLbl = Lbl({ Text="", Font=T.FontBd, TextSize=13, TextColor3=T.AccentLt,
		TextXAlignment=Enum.TextXAlignment.Right, AnchorPoint=Vector2.new(1,0),
		Position=UDim2.new(1,-14,0,10), Size=UDim2.fromOffset(90,18), Parent=el })

	local bar  = New("Frame", { Position=UDim2.new(0,14,1,-19), Size=UDim2.new(1,-28,0,6),
		BackgroundColor3=T.Bg, Parent=el }, { Round() })
	local fill = New("Frame", { Size=UDim2.new(0,0,1,0), BackgroundColor3=Color3.new(1,1,1),
		Parent=bar }, { Round(), AccentGrad(0) })
	local knob = New("Frame", { AnchorPoint=Vector2.new(0.5,0.5), Position=UDim2.new(0,0,0.5,0),
		Size=UDim2.fromOffset(15,15), BackgroundColor3=Color3.new(1,1,1), ZIndex=2, Parent=bar },
		{ Round(), Stroke(T.Accent,2,0) })
	local hit  = New("TextButton", { AnchorPoint=Vector2.new(0,0.5), Position=UDim2.new(0,0,0.5,0),
		Size=UDim2.new(1,0,0,26), BackgroundTransparency=1, Text="", ZIndex=3, Parent=bar })

	local function fmt(v) return string.format("%."..dec.."f", v)..suf end
	local function set(v, t)
		v = math.clamp(v, min, max)
		v = math.floor((v-min)/inc+0.5)*inc+min
		v = math.clamp(v, min, max)
		val = v
		local r = (max==min) and 0 or (v-min)/(max-min)
		Tw(fill,  { Size=UDim2.new(r,0,1,0) }, t or 0.08)
		Tw(knob,  { Position=UDim2.new(r,0,0.5,0) }, t or 0.08)
		vLbl.Text = fmt(v)
	end
	set(val, 0)

	local dragging = false
	local function upd(x)
		local r = math.clamp((x-bar.AbsolutePosition.X)/bar.AbsoluteSize.X, 0, 1)
		local prev = val; set(min+(max-min)*r, 0.06)
		if val ~= prev then Fire(cfg.Callback, val) end
	end
	hit.InputBegan:Connect(function(i)
		if IsClick(i) then dragging=true; Tw(knob,{Size=UDim2.fromOffset(19,19)},0.12); upd(i.Position.X) end
	end)
	self.Window:_on(UserInputService.InputChanged, function(i)
		if dragging and (i.UserInputType==Enum.UserInputType.MouseMovement
			or i.UserInputType==Enum.UserInputType.Touch) then upd(i.Position.X) end
	end)
	self.Window:_on(UserInputService.InputEnded, function(i)
		if dragging and IsClick(i) then dragging=false; Tw(knob,{Size=UDim2.fromOffset(15,15)},0.12) end
	end)
	el.MouseEnter:Connect(function() Tw(el,{BackgroundColor3=T.ElHover},0.12) end)
	el.MouseLeave:Connect(function() Tw(el,{BackgroundColor3=T.El},0.12) end)
	return {
		Set = function(_,v) set(v,0.2); Fire(cfg.Callback, val) end,
		Get = function() return val end,
	}
end

