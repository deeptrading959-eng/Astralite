local Astralite = {}
local Win = {}; Win.__index = Win
local Tab = {}; Tab.__index = Tab

function Astralite:CreateWindow(cfg)
	cfg = cfg or {}
	local self   = setmetatable({}, Win)
	self.Title   = cfg.Title    or "Astralite"
	self.Sub     = cfg.Subtitle or "v1.0"
	self.W       = (cfg.Size and cfg.Size.X) or 700
	self.H       = (cfg.Size and cfg.Size.Y) or 460
	self.Key     = cfg.Key      or Enum.KeyCode.RightShift
	self.Tabs    = {}
	self.Conns   = {}
	self.Current = nil
	self.Minimized = false
	self.Order   = 0
	self.Visible = true

	-- destroy old
	local old = PlayerGui:FindFirstChild("AstraliteV2")
	if old then old:Destroy() end

	-- ScreenGui
	local gui = New("ScreenGui", { Name="AstraliteV2", ResetOnSpawn=false,
		ZIndexBehavior=Enum.ZIndexBehavior.Sibling, Parent=PlayerGui })
	self.Gui = gui

	-- Root holder
	local holder = New("Frame", { Name="Holder", BackgroundTransparency=1,
		Size=UDim2.fromOffset(self.W, self.H),
		Position=UDim2.new(0.5,-self.W/2, 0.5,-self.H/2), Parent=gui })
	self.Holder  = holder
	local hScale = New("UIScale", { Scale=0.88, Parent=holder })
	self.HScale  = hScale

	-- Glow layers
	for _, g in ipairs({{12,0.87},{25,0.93},{42,0.97}}) do
		New("Frame", { AnchorPoint=Vector2.new(0.5,0.5), Position=UDim2.fromScale(0.5,0.5),
			Size=UDim2.new(1,g[1],1,g[1]), BackgroundColor3=T.Accent,
			BackgroundTransparency=g[2], BorderSizePixel=0, ZIndex=1, Parent=holder },
			{ Corner(14+g[1]/2) })
	end

	-- Main frame
	local main = New("Frame", { Name="Main", Size=UDim2.fromScale(1,1),
		BackgroundColor3=T.Bg, BorderSizePixel=0, ClipsDescendants=true, ZIndex=2, Parent=holder },
		{ Corner(14), Grad(T.BgHi, T.Bg, 55) })
	self.Main = main
	self.MainStroke = Stroke(T.Accent, 1.5, 0.3)
	self.MainStroke.Parent = main

	-- Topbar
	local topbar = New("Frame", { Size=UDim2.new(1,0,0,48), BackgroundTransparency=1, Parent=main })

	-- Logo + title
	local titleRow = New("Frame", { BackgroundTransparency=1,
		Position=UDim2.fromOffset(14,0), Size=UDim2.new(1,-120,1,0), Parent=topbar },
		{ New("UIListLayout", { FillDirection=Enum.FillDirection.Horizontal,
			VerticalAlignment=Enum.VerticalAlignment.Center,
			SortOrder=Enum.SortOrder.LayoutOrder, Padding=UDim.new(0,10) }) })

	local logo = New("Frame", { Size=UDim2.fromOffset(28,28), BackgroundColor3=Color3.new(1,1,1),
		LayoutOrder=1, Parent=titleRow }, { Corner(8), AccentGrad(45) })
	Lbl({ Text=string.sub(self.Title,1,1), Font=T.FontBd, TextSize=16,
		TextXAlignment=Enum.TextXAlignment.Center, Size=UDim2.fromScale(1,1), Parent=logo })

	local titleLbl = Lbl({ Text=self.Title, Font=T.FontBd, TextSize=17,
		Size=UDim2.new(0,0,1,0), AutomaticSize=Enum.AutomaticSize.X, LayoutOrder=2, Parent=titleRow })
	Grad(T.Text, T.AccentLt).Parent = titleLbl

	local subChip = Lbl({ Text=self.Sub, Font=T.FontMd, TextSize=11, TextColor3=T.AccentLt,
		BackgroundColor3=T.El, BackgroundTransparency=0,
		Size=UDim2.fromOffset(0,22), AutomaticSize=Enum.AutomaticSize.X,
		LayoutOrder=3, Parent=titleRow })
	Corner(6).Parent=subChip; Pad(0,0,9,9).Parent=subChip; Stroke(T.Stroke,1,0.3).Parent=subChip
	self.SubChip = subChip

	-- Window controls
	local function WinBtn(sym, xOff, hc)
		local btn = New("TextButton", { AnchorPoint=Vector2.new(1,0.5),
			Position=UDim2.new(1,xOff,0.5,0), Size=UDim2.fromOffset(30,30),
			BackgroundColor3=T.El, BackgroundTransparency=1, AutoButtonColor=false,
			Text=sym, Font=T.FontBd, TextSize=17, TextColor3=T.Sub, Parent=topbar },
			{ Corner(8) })
		btn.MouseEnter:Connect(function()
			Tw(btn, { BackgroundTransparency=0, BackgroundColor3=hc, TextColor3=T.Text }, 0.12)
		end)
		btn.MouseLeave:Connect(function()
			Tw(btn, { BackgroundTransparency=1, TextColor3=T.Sub }, 0.12)
		end)
		return btn
	end

	local closeBtn = WinBtn("✕", -10, T.Danger)
	closeBtn.TextSize = 13
	local minBtn   = WinBtn("—", -46, T.ElHover)
	self.MinBtn = minBtn

	-- topbar divider
	local div = New("Frame", { Position=UDim2.new(0,0,1,-1), Size=UDim2.new(1,0,0,1),
		BackgroundColor3=T.Stroke, BackgroundTransparency=0.35, BorderSizePixel=0, Parent=topbar })
	self.Div = div

	-- Sidebar
	local SW = 195
	local sidebar = New("Frame", { Position=UDim2.fromOffset(0,48),
		Size=UDim2.new(0,SW,1,-48), BackgroundColor3=T.Sidebar,
		BackgroundTransparency=0.15, BorderSizePixel=0, Parent=main }, { Corner(14) })
	-- square right & top edges
	New("Frame", { Size=UDim2.new(1,0,0,14), BackgroundColor3=T.Sidebar,
		BackgroundTransparency=0.15, BorderSizePixel=0, Parent=sidebar })
	New("Frame", { AnchorPoint=Vector2.new(1,0), Position=UDim2.new(1,0,0,14),
		Size=UDim2.new(0,14,1,-14), BackgroundColor3=T.Sidebar,
		BackgroundTransparency=0.15, BorderSizePixel=0, Parent=sidebar })
	New("Frame", { AnchorPoint=Vector2.new(1,0), Position=UDim2.new(1,0,0,0),
		Size=UDim2.new(0,1,1,0), BackgroundColor3=T.Stroke,
		BackgroundTransparency=0.3, BorderSizePixel=0, Parent=sidebar })

	-- Tab list
	local tabList = New("ScrollingFrame", { Size=UDim2.new(1,-1,1,-68),
		BackgroundTransparency=1, BorderSizePixel=0, ScrollBarThickness=0,
		CanvasSize=UDim2.new(0,0,0,0), AutomaticCanvasSize=Enum.AutomaticSize.Y, Parent=sidebar },
		{ List(5), Pad(10,10,10,10) })
	self.TabList = tabList

	-- Profile card
	local profile = New("Frame", { AnchorPoint=Vector2.new(0,1),
		Position=UDim2.new(0,10,1,-10), Size=UDim2.new(1,-21,0,50),
		BackgroundColor3=T.El, Parent=sidebar }, { Corner(10), Stroke(T.Stroke,1,0.4) })
	local ava = New("ImageLabel", { AnchorPoint=Vector2.new(0,0.5),
		Position=UDim2.new(0,8,0.5,0), Size=UDim2.fromOffset(32,32),
		BackgroundColor3=T.Bg, Image="", Parent=profile },
		{ Round(), Stroke(T.Accent,1.5,0.25) })
	Lbl({ Text=LocalPlayer.DisplayName, Font=T.FontBd, TextSize=13,
		TextTruncate=Enum.TextTruncate.AtEnd, Position=UDim2.fromOffset(48,8),
		Size=UDim2.new(1,-58,0,16), Parent=profile })
	Lbl({ Text="@"..LocalPlayer.Name, TextSize=11, TextColor3=T.Sub,
		TextTruncate=Enum.TextTruncate.AtEnd, Position=UDim2.fromOffset(48,26),
		Size=UDim2.new(1,-58,0,14), Parent=profile })
	task.spawn(function()
		local ok, img = pcall(function()
			return Players:GetUserThumbnailAsync(LocalPlayer.UserId,
				Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size48x48)
		end)
		if ok and ava.Parent then ava.Image = img end
	end)

	-- Content area
	local content = New("Frame", { Position=UDim2.fromOffset(SW,48),
		Size=UDim2.new(1,-SW,1,-48), BackgroundTransparency=1, Parent=main })
	self.PageTitle = Lbl({ Text="", Font=T.FontBd, TextSize=15,
		Position=UDim2.fromOffset(18,0), Size=UDim2.new(1,-36,0,44), Parent=content })
	local pageSep = New("Frame", { Position=UDim2.new(0,14,0,43),
		Size=UDim2.new(1,-28,0,1), BackgroundColor3=T.Stroke,
		BackgroundTransparency=0.5, BorderSizePixel=0, Parent=content })
	self.Pages = New("Frame", { Position=UDim2.fromOffset(0,44),
		Size=UDim2.new(1,0,1,-44), BackgroundTransparency=1,
		ClipsDescendants=true, Parent=content })

	-- Notification holder
	self.Notifs = New("Frame", { AnchorPoint=Vector2.new(1,1),
		Position=UDim2.new(1,-18,1,-18), Size=UDim2.new(0,295,1,-40),
		BackgroundTransparency=1, Parent=gui },
		{ New("UIListLayout", { Padding=UDim.new(0,8), SortOrder=Enum.SortOrder.LayoutOrder,
			VerticalAlignment=Enum.VerticalAlignment.Bottom }) })

	-- Close dialog
	local overlay = New("TextButton", { Size=UDim2.fromScale(1,1), BackgroundColor3=Color3.new(0,0,0),
		BackgroundTransparency=1, AutoButtonColor=false, Text="", Visible=false, ZIndex=20, Parent=main })
	local dialog = New("Frame", { AnchorPoint=Vector2.new(0.5,0.5), Position=UDim2.fromScale(0.5,0.5),
		Size=UDim2.fromOffset(310,150), BackgroundColor3=T.Sidebar, Parent=overlay },
		{ Corner(12), Stroke(T.Accent,1.5,0.3) })
	local dScale = New("UIScale", { Scale=0.88, Parent=dialog })
	Lbl({ Text="Hide the interface?", Font=T.FontBd, TextSize=15,
		Position=UDim2.fromOffset(18,16), Size=UDim2.new(1,-36,0,20), Parent=dialog })
	Lbl({ Text="Press DEL at any time to reopen it.", TextSize=13, TextColor3=T.Sub,
		TextWrapped=true, TextYAlignment=Enum.TextYAlignment.Top,
		Position=UDim2.fromOffset(18,42), Size=UDim2.new(1,-36,0,36), Parent=dialog })

	local function DlgBtn(label, xsc, xoff, primary)
		local btn = New("TextButton", { AnchorPoint=Vector2.new(xsc,1),
			Position=UDim2.new(xsc,xoff,1,-14), Size=UDim2.new(0.5,-22,0,32),
			BackgroundColor3=primary and T.Danger or T.El, AutoButtonColor=false,
			Text=label, Font=T.FontBd, TextSize=13, TextColor3=T.Text, Parent=dialog },
			{ Corner(8) })
		if not primary then Stroke(T.Stroke,1,0.3).Parent=btn end
		btn.MouseEnter:Connect(function()
			Tw(btn, { BackgroundColor3=primary and Color3.fromRGB(240,88,118) or T.ElHover }, 0.12)
		end)
		btn.MouseLeave:Connect(function()
			Tw(btn, { BackgroundColor3=primary and T.Danger or T.El }, 0.12)
		end)
		return btn
	end
	local cancelBtn  = DlgBtn("Cancel", 0, 16, false)
	local confirmBtn = DlgBtn("Hide",   1,-16, true)

	local function ShowDialog(v)
		if v then
			overlay.Visible=true; dScale.Scale=0.88
			Tw(overlay, { BackgroundTransparency=0.5 }, 0.18)
			Tw(dScale,  { Scale=1 }, 0.28, Enum.EasingStyle.Back)
		else
			Tw(overlay, { BackgroundTransparency=1 }, 0.14)
			Tw(dScale,  { Scale=0.88 }, 0.14)
			task.delay(0.15, function() overlay.Visible=false end)
		end
	end

	closeBtn.MouseButton1Click:Connect(function() ShowDialog(true) end)
	cancelBtn.MouseButton1Click:Connect(function() ShowDialog(false) end)
	confirmBtn.MouseButton1Click:Connect(function()
		ShowDialog(false)
		self:SetVisible(false)
	end)
	minBtn.MouseButton1Click:Connect(function() self:SetMinimized(not self.Minimized) end)

	-- Drag
	local drag, dragStart, startPos = false, nil, nil
	topbar.InputBegan:Connect(function(i)
		if IsClick(i) then drag=true; dragStart=i.Position; startPos=holder.Position end
	end)
	self:_on(UserInputService.InputChanged, function(i)
		if drag and (i.UserInputType==Enum.UserInputType.MouseMovement
			or i.UserInputType==Enum.UserInputType.Touch) then
			local d = i.Position - dragStart
			holder.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset+d.X,
				startPos.Y.Scale, startPos.Y.Offset+d.Y)
		end
	end)
	self:_on(UserInputService.InputEnded, function(i) if IsClick(i) then drag=false end end)

	-- Keybinds
	self:_on(UserInputService.InputBegan, function(i, gp)
		if gp then return end
		if i.KeyCode == self.Key then self:SetVisible(not self.Visible) end
		if i.KeyCode == Enum.KeyCode.Delete then self:SetVisible(true) end
	end)

	Tw(hScale, { Scale=1 }, 0.42, Enum.EasingStyle.Back)
	return self
end

function Win:_on(sig, fn)
	local c = sig:Connect(fn)
	table.insert(self.Conns, c)
	return c
end

function Win:SetVisible(v)
	self.Visible = v
	if v then
		self.Holder.Visible = true
		self.HScale.Scale   = 0.92
		Tw(self.HScale, { Scale=1 }, 0.28, Enum.EasingStyle.Back)
	else
		Tw(self.HScale, { Scale=0.92 }, 0.14)
		task.delay(0.15, function()
			if not self.Visible then self.Holder.Visible = false end
		end)
	end
end

function Win:SetMinimized(v)
	self.Minimized = v
	Tw(self.Holder, { Size=UDim2.fromOffset(self.W, v and 48 or self.H) }, 0.32)
	self.MinBtn.Text = v and "+" or "—"
	self.Div.Visible = not v
end

function Win:Select(tab)
	if self.Current == tab then return end
	if self.Current then
		self.Current.Frame.Visible = false
		self.Current:_setActive(false)
	end
	self.Current = tab
	tab:_setActive(true)
	local hex = T.AccentLt:ToHex()
	self.PageTitle.Text = string.format('<font color="#%s">%s</font>', hex, tab.Name)
	self.PageTitle.RichText = true
	tab.Frame.Visible = true
	tab.Frame.Position = UDim2.fromOffset(0, 12)
	Tw(tab.Frame, { Position=UDim2.fromOffset(0,0) }, 0.3)
end

function Win:Notify(cfg)
	cfg = cfg or {}
	local dur = cfg.Duration or 4
	local wrap = New("Frame", { Size=UDim2.new(1,0,0,0), AutomaticSize=Enum.AutomaticSize.Y,
		BackgroundTransparency=1, Parent=self.Notifs })
	local card = New("Frame", { Position=UDim2.new(1,44,0,0), Size=UDim2.new(1,0,0,0),
		AutomaticSize=Enum.AutomaticSize.Y, BackgroundColor3=T.Sidebar,
		ClipsDescendants=true, Parent=wrap }, { Corner(10), Stroke(T.Accent,1,0.3) })
	New("Frame", { Position=UDim2.fromOffset(10,10), Size=UDim2.new(0,3,1,-20),
		BackgroundColor3=Color3.new(1,1,1), BorderSizePixel=0, Parent=card },
		{ Round(), AccentGrad(90) })
	local body = New("Frame", { Size=UDim2.new(1,0,0,0), AutomaticSize=Enum.AutomaticSize.Y,
		BackgroundTransparency=1, Parent=card }, { List(4), Pad(10,14,24,14) })
	Lbl({ Text=cfg.Title or "Notice", Font=T.FontBd, TextSize=14,
		Size=UDim2.new(1,0,0,18), LayoutOrder=1, Parent=body })
	Lbl({ Text=cfg.Content or "", TextSize=13, TextColor3=T.Sub, TextWrapped=true,
		Size=UDim2.new(1,0,0,0), AutomaticSize=Enum.AutomaticSize.Y,
		LayoutOrder=2, Parent=body })
	local bar = New("Frame", { AnchorPoint=Vector2.new(0,1), Position=UDim2.new(0,0,1,0),
		Size=UDim2.new(1,0,0,3), BackgroundColor3=Color3.new(1,1,1),
		BorderSizePixel=0, Parent=card }, { AccentGrad(0) })
	Tw(card, { Position=UDim2.new(0,0,0,0) }, 0.4, Enum.EasingStyle.Quint)
	Tw(bar,  { Size=UDim2.new(0,0,0,3) }, dur, Enum.EasingStyle.Linear)
	task.delay(dur, function()
		if not card.Parent then return end
		local t = Tw(card, { Position=UDim2.new(1,44,0,0) }, 0.3, Enum.EasingStyle.Quint, Enum.EasingDirection.In)
		t.Completed:Wait(); wrap:Destroy()
	end)
end

---------------------------------------------------------------------
-- Tabs
---------------------------------------------------------------------
function Win:Tab(name, icon)
	local tab = setmetatable({}, Tab)
	tab.Window = self
	tab.Name   = name
	tab.Order  = 0
	tab._sec   = nil
	self.Order = self.Order + 1

	local btn = New("TextButton", { Size=UDim2.new(1,0,0,38), BackgroundColor3=T.El,
		BackgroundTransparency=1, AutoButtonColor=false, Text="",
		LayoutOrder=self.Order, Parent=self.TabList }, { Corner(8) })
	tab.Btn = btn

	local iconBox = New("Frame", { AnchorPoint=Vector2.new(0,0.5),
		Position=UDim2.new(0,8,0.5,0), Size=UDim2.fromOffset(24,24),
		BackgroundColor3=T.El, Parent=btn }, { Corner(7) })
	tab.IconBox = iconBox
	tab.IconLbl = Lbl({ Text=icon or string.upper(string.sub(name,1,1)),
		Font=T.FontBd, TextSize=12, TextColor3=T.Sub,
		TextXAlignment=Enum.TextXAlignment.Center,
		Size=UDim2.fromScale(1,1), Parent=iconBox })
	tab.NameLbl = Lbl({ Text=name, Font=T.FontMd, TextSize=14, TextColor3=T.Sub,
		Position=UDim2.fromOffset(42,0), Size=UDim2.new(1,-54,1,0), Parent=btn })

	tab.Frame = New("ScrollingFrame", { Name=name, Size=UDim2.fromScale(1,1),
		BackgroundTransparency=1, BorderSizePixel=0, ScrollBarThickness=3,
		ScrollBarImageColor3=T.Accent, CanvasSize=UDim2.new(0,0,0,0),
		AutomaticCanvasSize=Enum.AutomaticSize.Y, Visible=false, Parent=self.Pages },
		{ List(8), Pad(4,16,16,18) })

	btn.MouseEnter:Connect(function()
		if self.Current~=tab then Tw(btn,{BackgroundTransparency=0.55},0.12) end
	end)
	btn.MouseLeave:Connect(function()
		if self.Current~=tab then Tw(btn,{BackgroundTransparency=1},0.12) end
	end)
	btn.MouseButton1Click:Connect(function() self:Select(tab) end)

	table.insert(self.Tabs, tab)
	if self.Current == nil then self:Select(tab) end
	return tab
end

function Tab:_setActive(v)
	Tw(self.Btn,     { BackgroundTransparency=v and 0 or 1 }, 0.18)
	Tw(self.IconBox, { BackgroundColor3=v and T.Accent or T.El }, 0.18)
	Tw(self.IconLbl, { TextColor3=v and T.Text or T.Sub }, 0.18)
	Tw(self.NameLbl, { TextColor3=v and T.Text or T.Sub }, 0.18)
end

---------------------------------------------------------------------
-- Element helpers
---------------------------------------------------------------------
function Tab:_next()
	self.Order = self.Order + 1
	return self.Order
end

function Tab:_el(h, isBtn)
	local el = New(isBtn and "TextButton" or "Frame", { Size=UDim2.new(1,0,0,h),
		BackgroundColor3=T.El, BorderSizePixel=0, LayoutOrder=self:_next(), Parent=self.Frame },
		{ Corner(8), Stroke(T.Stroke,1,0.5) })
	if isBtn then el.Text=""; el.AutoButtonColor=false end
	if self._sec then self._sec:_reg(el) end
	return el
end

local function ElTitle(p, text, w)
	return Lbl({ Text=text, Font=T.FontMd, TextSize=14, TextTruncate=Enum.TextTruncate.AtEnd,
		Position=UDim2.fromOffset(14,0), Size=UDim2.new(1,w or -80,1,0), Parent=p })
end

---------------------------------------------------------------------
-- Section
---------------------------------------------------------------------
function Tab:Section(title)
	local order = self:_next()
	local open  = true
	local kids  = {}

	local hdr = New("TextButton", { Size=UDim2.new(1,0,0,30), BackgroundTransparency=1,
		AutoButtonColor=false, Text="", LayoutOrder=order, Parent=self.Frame })
	New("Frame", { AnchorPoint=Vector2.new(0,1), Position=UDim2.new(0,2,1,-7),
		Size=UDim2.fromOffset(3,14), BackgroundColor3=Color3.new(1,1,1),
		BorderSizePixel=0, Parent=hdr }, { Round(), AccentGrad(90) })
	Lbl({ Text=title, Font=T.FontBd, TextSize=13, TextColor3=T.AccentLt,
		TextYAlignment=Enum.TextYAlignment.Bottom,
		Position=UDim2.fromOffset(12,0), Size=UDim2.new(1,-30,1,-6), Parent=hdr })
	local arrow = Lbl({ Text="\\/", Font=T.FontBd, TextSize=13, TextColor3=T.AccentLt,
		TextXAlignment=Enum.TextXAlignment.Center, AnchorPoint=Vector2.new(1,1),
		Position=UDim2.new(1,-8,1,-6), Size=UDim2.fromOffset(16,16), Parent=hdr })

	local sec = { _reg=function(self, el) table.insert(kids, el) end }
	self._sec = sec

	hdr.MouseButton1Click:Connect(function()
		open = not open
		arrow.Text = open and "\\/" or "/\\"
		for _, el in ipairs(kids) do el.Visible = open end
	end)

	return sec
end

---------------------------------------------------------------------
-- Label / Paragraph
---------------------------------------------------------------------
function Tab:Label(text)
	local lbl = Lbl({ Text=text, TextSize=13, TextColor3=T.Sub, TextWrapped=true,
		Size=UDim2.new(1,0,0,0), AutomaticSize=Enum.AutomaticSize.Y,
		LayoutOrder=self:_next(), Parent=self.Frame })
	Pad(2,2,4,4).Parent=lbl
	if self._sec then self._sec:_reg(lbl) end
	return { Set=function(_,t) lbl.Text=t end }
end

function Tab:Paragraph(title, body)
	local el = self:_el(0)
	el.AutomaticSize = Enum.AutomaticSize.Y
	List(5).Parent=el; Pad(12,12,14,14).Parent=el
	local tl = Lbl({ Text=title, Font=T.FontBd, TextSize=14,
		Size=UDim2.new(1,0,0,18), LayoutOrder=1, Parent=el })
	local bl = Lbl({ Text=body, TextSize=13, TextColor3=T.Sub, TextWrapped=true,
		TextYAlignment=Enum.TextYAlignment.Top, Size=UDim2.new(1,0,0,0),
		AutomaticSize=Enum.AutomaticSize.Y, LayoutOrder=2, Parent=el })
	return { Set=function(_,t,b) tl.Text=t or tl.Text; bl.Text=b or bl.Text end }
end

