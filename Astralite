local function clearESP(model)
	local d = ESPObjects[model]
	if not d then return end
	for _, inst in ipairs(d.instances) do
		pcall(function() inst:Destroy() end)
	end
	ESPObjects[model] = nil
end

---------------------------------------------------------------------
-- Build ESP for a character model
---------------------------------------------------------------------
local function buildCharESP(model, category, color, showHealth, showDist, showName)
	clearESP(model)
	local data = { instances = {}, bones = {}, category = category }
	ESPObjects[model] = data

	local boxKey = category .. "Boxes"

	if ESPState[boxKey] then
		for _, b in ipairs(makeBoxes(model, color)) do
			table.insert(data.instances, b)
		end
	end

	local hrp = model:FindFirstChild("HumanoidRootPart")
		or model:FindFirstChildWhichIsA("BasePart")

	if hrp then
		local labelY = 3.5

		if showName then
			local bb, lbl = makeLabel(hrp, labelY)
			lbl.Text       = model.Name
			lbl.TextColor3 = color
			table.insert(data.instances, bb)
			labelY = labelY + 1.2
		end
		if showHealth then
			local bb, lbl = makeLabel(hrp, labelY)
			table.insert(data.instances, bb)
			data.healthLabel = lbl
			data.humanoid    = model:FindFirstChildWhichIsA("Humanoid")
			labelY = labelY + 1.2
		end
		if showDist then
			local bb, lbl = makeLabel(hrp, labelY)
			table.insert(data.instances, bb)
			data.distLabel = lbl
		end
		data.hrp = hrp
	end
end

