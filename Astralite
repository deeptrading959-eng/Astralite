function Window:AddTab(name, icon)
	local tab = setmetatable({}, Tab)
	tab.Window = self
	tab.Name = name
	tab.Order = 0

	self.TabOrder = self.TabOrder + 1

	-- Sidebar button
	local button = Create("TextButton", {
		Size = UDim2.new(1, 0, 0, 36),
		BackgroundColor3 = Theme.Element,
		BackgroundTransparency = 1,
		AutoButtonColor = false,
		Text = "",
		LayoutOrder = self.TabOrder,
		Parent = self.TabList,
	}, { Corner(8) })
	tab.Button = button

	local iconBox = Create("Frame", {
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 8, 0.5, 0),
		Size = UDim2.fromOffset(22, 22),
		BackgroundColor3 = Theme.Element,
		Parent = button,
	}, { Corner(6) })
	tab.IconBox = iconBox
	tab.IconText = Text({
		Text = icon or string.upper(string.sub(name, 1, 1)),
		Font = Theme.FontBold,
		TextSize = 12,
		TextColor3 = Theme.SubText,
		TextXAlignment = Enum.TextXAlignment.Center,
		Size = UDim2.fromScale(1, 1),
		Parent = iconBox,
	})

	tab.Label = Text({
		Text = name,
		Font = Theme.FontMedium,
		TextSize = 14,
		TextColor3 = Theme.SubText,
		Position = UDim2.fromOffset(40, 0),
		Size = UDim2.new(1, -50, 1, 0),
		Parent = button,
	})

	-- Content page (scrolling frame directly on the tab)
	tab.Frame = Create("ScrollingFrame", {
		Name = name,
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 3,
		ScrollBarImageColor3 = Theme.Accent,
		CanvasSize = UDim2.new(0, 0, 0, 0),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		Visible = false,
		Parent = self.Pages,
	}, { List(8), Padding(4, 16, 16, 18) })

	button.MouseEnter:Connect(function()
		if self.Current ~= tab then
			Tween(button, { BackgroundTransparency = 0.5 }, 0.15)
		end
	end)
	button.MouseLeave:Connect(function()
		if self.Current ~= tab then
			Tween(button, { BackgroundTransparency = 1 }, 0.15)
		end
	end)
	button.MouseButton1Click:Connect(function()
		self:Select(tab)
	end)

	table.insert(self.Tabs, tab)

	-- auto-select first tab
	if self.Current == nil then
		self:Select(tab)
	end

	return tab
end

function Tab:SetActive(active)
	Tween(self.Button, { BackgroundTransparency = active and 0 or 1 }, 0.2)
	Tween(self.IconBox, { BackgroundColor3 = active and Theme.Accent or Theme.Element }, 0.2)
	Tween(self.IconText, { TextColor3 = active and Theme.Text or Theme.SubText }, 0.2)
	Tween(self.Label, { TextColor3 = active and Theme.Text or Theme.SubText }, 0.2)
end

