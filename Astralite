		Parent = el,
	}, { Corner(6), Padding(0, 0, 12, 12) })
	local chipStroke = Stroke(Theme.Stroke, 1, 0.2)
	chipStroke.Parent = chip

	chip.MouseButton1Click:Connect(function()
