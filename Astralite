local function getCharCategory(model)
	-- Player character?
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= LocalPlayer and p.Character == model then
			return "Player"
		end
	end
	-- In Monsters folder?
	local monsters = workspace:FindFirstChild("Monsters")
	if monsters and model:IsDescendantOf(monsters) then
		return "Monster"
	end
	-- In NPCs folder?
	local npcs = workspace:FindFirstChild("NPCs")
	if npcs and model:IsDescendantOf(npcs) then
		return "NPC"
	end
	return nil
end

local function rebuildAll()
	-- Collect all current valid models
	local charTargets = {}
	local dropTargets = {}

	-- Player characters
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= LocalPlayer and p.Character then
			charTargets[p.Character] = "Player"
		end
	end

	-- Monsters
	local monsFolder = workspace:FindFirstChild("Monsters")
	if monsFolder then
		for _, model in ipairs(monsFolder:GetChildren()) do
			if model:IsA("Model") then
				charTargets[model] = "Monster"
			end
		end
	end

	-- NPCs
	local npcFolder = workspace:FindFirstChild("NPCs")
	if npcFolder then
		for _, model in ipairs(npcFolder:GetChildren()) do
			if model:IsA("Model") then
				charTargets[model] = "NPC"
			end
		end
	end

	-- Drops
	local dropsFolder = workspace:FindFirstChild("Drops")
	if dropsFolder and ESPState.DropsEnabled then
		for _, model in ipairs(dropsFolder:GetChildren()) do
			if model:IsA("Model") then
				dropTargets[model] = true
			end
		end
	end

	-- Clear stale
	for model in pairs(ESPObjects) do
		if not charTargets[model] and not dropTargets[model] then
			clearESP(model)
		end
	end

	-- Build char ESP
	for model, cat in pairs(charTargets) do
		local boxKey  = cat .. "Boxes"
		local hlthKey = cat .. "Health"
		local distKey = cat .. "Distance"
		local nameKey = cat .. "Name"
		local anyOn = ESPState[boxKey] or ESPState[hlthKey] or ESPState[distKey] or ESPState[nameKey]
		if anyOn then
			buildCharESP(model, cat, CAT_COLORS[cat],
				ESPState[hlthKey], ESPState[distKey], ESPState[nameKey])
		else
			clearESP(model)
		end
	end

	-- Build drop ESP
	for model in pairs(dropTargets) do
		buildDropESP(model)
	end
	-- Clear drops if disabled
	if not ESPState.DropsEnabled then
		for model, d in pairs(ESPObjects) do
			if d.category == "Drop" then clearESP(model) end
		end
	end
end

