local idolFarmState = { running = false, serverhopping = false }

local IDOL_NAMES = {
	["Idol of Hatred"] = true,
	["Stone Accord"]   = true,
}

local function doIdolFarm()
	local dropsFolder = workspace:FindFirstChild("Drops")
	if not dropsFolder then task.wait(2) return end

	local targets = {}
	for _, drop in ipairs(dropsFolder:GetChildren()) do
		if drop:IsA("Model") and IDOL_NAMES[drop.Name] then
			local part = drop:FindFirstChildWhichIsA("BasePart")
			if part then
				table.insert(targets, { model = drop, pos = part.Position })
			end
		end
	end

	if #targets == 0 then
		if idolFarmState.serverhopping then
			Window:Notify({
				Title   = "Idol Farm",
				Content = "No idol found - serverhopping...",
				Duration = 3,
			})
			task.wait(2)
			doRejoin()
			task.wait(10)
		else
			task.wait(2)
		end
		return
	end

	table.sort(targets, function(a, b)
		return distFrom(a.pos) < distFrom(b.pos)
	end)

	for _, t in ipairs(targets) do
		if not farmThreads["idolfarm"] then return end
		if t.model.Parent then
			local countBefore = getBackpackCount()
			local deadline = tick() + 5
			local target = CFrame.new(t.pos + Vector3.new(0, 3, 0))

			local conn
			conn = RenderStepped:Connect(function()
				local c = LocalPlayer.Character
				if not c then return end
				local hrp = c:FindFirstChild("HumanoidRootPart")
				if not hrp then return end
				local hum = c:FindFirstChildOfClass("Humanoid")
				if hum then hum.PlatformStand = true end
				pcall(function() c:PivotTo(target) end)
				if hum then hum.PlatformStand = false end
			end)

			while tick() < deadline do
				if not farmThreads["idolfarm"] then
					conn:Disconnect()
					return
				end
				if not t.model.Parent then break end
				if getBackpackCount() ~= countBefore then break end
				pressE()
				task.wait(0.05)
			end

			conn:Disconnect()
		end
	end
end

