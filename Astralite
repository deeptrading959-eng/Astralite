-- spam tp to position every frame for duration seconds, spamming E the whole time
local function spamTP(position, duration, runningFn)
	local char = LocalPlayer.Character
	if not char then return end
	local hum = char:FindFirstChildOfClass("Humanoid")
	local target = CFrame.new(position + Vector3.new(0, 3, 0))

	local deadline = tick() + (duration or 0.5)
	local conn
	conn = RenderStepped:Connect(function()
		local c = LocalPlayer.Character
		if not c then return end
		if hum then hum.PlatformStand = true end
		c:PivotTo(target)
		if hum then hum.PlatformStand = false end
	end)

	-- spam E while tp is running
	while tick() < deadline do
		if runningFn and not runningFn() then break end
		pressE()
		task.wait(0.05)
	end

	conn:Disconnect()
	if hum then hum.PlatformStand = false end
end

