local SAVE_FILE   = "astralite_prefs.json"
local saveData    = {}      -- populated by toggles/sliders as they fire
local saveEnabled = true

local function encodeJSON(t)
	local parts = {}
	for k, v in pairs(t) do
		local vStr
		if type(v) == "boolean" then
			vStr = v and "true" or "false"
		elseif type(v) == "number" then
			vStr = tostring(v)
		elseif type(v) == "string" then
			vStr = '"' .. v:gsub('"', '\\"') .. '"'
		elseif type(v) == "table" then
			vStr = encodeJSON(v)
		else
			vStr = "null"
		end
		table.insert(parts, '"' .. tostring(k) .. '":' .. vStr)
	end
	return "{" .. table.concat(parts, ",") .. "}"
end

local function decodeJSON(str)
	-- lightweight decoder for flat boolean/number tables
	local out = {}
	for k, v in str:gmatch('"([^"]+)":([^,}]+)') do
		if v == "true" then
			out[k] = true
		elseif v == "false" then
			out[k] = false
		elseif tonumber(v) then
			out[k] = tonumber(v)
		end
	end
	return out
end

local function savePrefs()
	pcall(function()
		writefile(SAVE_FILE, encodeJSON(saveData))
	end)
end

local function loadPrefs()
	local ok, content = pcall(readfile, SAVE_FILE)
	if ok and content and content ~= "" then
		return decodeJSON(content)
	end
	return {}
end

-- Auto-save every 20 seconds
task.spawn(function()
	while true do
		task.wait(20)
		if saveEnabled then savePrefs() end
	end
end)

-- Helper: register a key in saveData and return its loaded value
local savedPrefs = loadPrefs()
local function pref(key, default)
	saveData[key] = savedPrefs[key] ~= nil and savedPrefs[key] or default
	return saveData[key]
end
local function setPref(key, value)
	saveData[key] = value
end

-- detect active slot from SaveSlotSync and save it
local _activeSlot = savedPrefs["ActiveSlot"] or 1
pcall(function()
	local RS_s = game:GetService("ReplicatedStorage"):FindFirstChild("Remotes")
	local slotSync = RS_s and RS_s:FindFirstChild("SaveSlotSync")
	if slotSync then
		slotSync.OnClientEvent:Connect(function(data)
			if data and data.LastActiveSlot then
				_activeSlot = data.LastActiveSlot
				setPref("ActiveSlot", _activeSlot)
			end
		end)
	end
end)

