local ALERT_RARITIES = { Legendary = true, Mythic = true, Godly = true }
local alertedDrops   = {}  -- track which models we've already alerted for

local function buildDropESP(model)
	clearESP(model)
	local rarity = model:GetAttribute("Rarity") or "Common"
	if not ESPState.DropsRarities[rarity] then return end
	local color = RARITY_COLORS[rarity] or RARITY_COLORS.Common
	local data = { instances = {}, bones = {}, category = "Drop" }
	ESPObjects[model] = data
	for _, inst in ipairs(makeDropESP(model, color)) do
		table.insert(data.instances, inst)
	end

	-- Item Alert
	if ESPState.DropsAlert and ALERT_RARITIES[rarity] and not alertedDrops[model] then
		alertedDrops[model] = true
		Window:Notify({
			Title  = rarity .. " Drop!",
			Content = model.Name .. " has appeared nearby.",
			Duration = 6,
		})
	end
end

