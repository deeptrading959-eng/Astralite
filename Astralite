-- Rejoin system
local Y_OFFSET = 49

local function autoClickButton(btn)
	local pos = btn.AbsolutePosition + btn.AbsoluteSize / 2
	pos = Vector2.new(pos.X, pos.Y + Y_OFFSET)
	for i = 1, 10 do
		local cur = UserInputService:GetMouseLocation()
		local diffX = pos.X - cur.X
		local diffY = pos.Y - cur.Y
		if math.abs(diffX) < 2 and math.abs(diffY) < 2 then break end
		local before = UserInputService:GetMouseLocation()
		mousemoverel(diffX, diffY)
		task.wait(0.05)
		local after = UserInputService:GetMouseLocation()
		local actualX = after.X - before.X
		local actualY = after.Y - before.Y
		local scaleX = diffX ~= 0 and actualX / diffX or 1
		local scaleY = diffY ~= 0 and actualY / diffY or 1
		local cur2 = UserInputService:GetMouseLocation()
		local remX = pos.X - cur2.X
		local remY = pos.Y - cur2.Y
		if math.abs(remX) > 2 or math.abs(remY) > 2 then
			mousemoverel(remX / scaleX, remY / scaleY)
			task.wait(0.05)
		end
	end
	mouse1click()
end

local function waitForVisible(path, timeout)
	local PG = LocalPlayer:WaitForChild("PlayerGui")
	local deadline = tick() + (timeout or 20)
	while tick() < deadline do
		local obj = PG
		local ok = true
		for _, p in ipairs(path) do
			obj = obj:FindFirstChild(p)
			if not obj then ok = false break end
		end
		if ok and obj.Visible then return obj end
		task.wait(0.2)
	end
	return nil
end

doRejoin = function()
	pcall(savePrefs)
	Window:Notify({ Title = "Serverhop", Content = "Finding a new server...", Duration = 3 })

	local RS_remote = game:GetService("ReplicatedStorage"):FindFirstChild("Remotes")
	local serverListRemote = RS_remote and RS_remote:FindFirstChild("ReceiveServerList")
	local requestRemote    = RS_remote and RS_remote:FindFirstChild("RequestServerList")

	if not serverListRemote or not requestRemote then
		-- fallback: just teleport to any server
		Window:Notify({ Title = "Serverhop", Content = "No server list remote, doing blind rejoin...", Duration = 3 })
		pcall(function()
			game:GetService("TeleportService"):Teleport(game.PlaceId, LocalPlayer)
		end)
		return
	end

	-- request server list and wait for response
	local servers = nil
	local conn
	conn = serverListRemote.OnClientEvent:Connect(function(list)
		servers = list
		conn:Disconnect()
	end)
	requestRemote:FireServer()

	-- wait up to 5 seconds for the list
	local deadline = tick() + 5
	while not servers and tick() < deadline do
		task.wait(0.1)
	end
	conn:Disconnect()

	if not servers or #servers == 0 then
		Window:Notify({ Title = "Serverhop", Content = "No servers found, blind rejoin...", Duration = 3 })
		pcall(function()
			game:GetService("TeleportService"):Teleport(game.PlaceId, LocalPlayer)
		end)
		return
	end

	-- filter: not current server, has open slots, low pop preferred
	local candidates = {}
	for _, s in ipairs(servers) do
		if type(s) == "table" then
			local jobId     = s.jobId
			local players   = s.players   or 0
			local maxPlayers= s.maxPlayers or 16
			if jobId and jobId ~= game.JobId and players < maxPlayers then
				table.insert(candidates, s)
			end
		end
	end

	if #candidates == 0 then
		Window:Notify({ Title = "Serverhop", Content = "No other servers found.", Duration = 3 })
		return
	end

	-- sort by player count ascending (low pop first), pick randomly from bottom 10
	table.sort(candidates, function(a, b)
		return (a.players or 0) < (b.players or 0)
	end)
	local pool = math.min(10, #candidates)
	local pick = candidates[math.random(1, pool)]

	Window:Notify({
		Title   = "Serverhop",
		Content = "Joining server with " .. (pick.players or 0) .. " players...",
		Duration = 3,
	})

	task.wait(1)
	local ok, err = pcall(function()
		game:GetService("TeleportService"):TeleportToPlaceInstance(
			game.PlaceId,
			pick.jobId,
			LocalPlayer
		)
	end)
	if not ok then
		print("[Astralite] Serverhop failed:", err)
		pcall(function()
			game:GetService("TeleportService"):Teleport(game.PlaceId, LocalPlayer)
		end)
	end
end

-- restore farms and settings after loading into game
local function restoreSession()
	-- walk forward ~5 studs to break out of spawn forcefield
	task.spawn(function()
		local char = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
		local hrp = char:WaitForChild("HumanoidRootPart", 10)
		local hum = char:WaitForChild("Humanoid", 10)
		if not hrp or not hum then return end
		-- wait until humanoid is fully loaded and not dead
		local deadline = tick() + 10
		while hum.Health <= 0 and tick() < deadline do task.wait(0.2) end
		task.wait(0.5)
		local forward = hrp.CFrame.LookVector
		local target = hrp.Position + forward * 5
		hum:MoveTo(target)
		task.wait(1)
		hum:MoveTo(hrp.Position) -- stop
	end)

	-- restore bypass values
	BypassState.SpeedValue = savedPrefs["WalkSpeed"] or 16
	BypassState.JumpValue  = savedPrefs["JumpPower"]  or 50

	-- restore sell rarities
	for _, r in ipairs({"Common","Uncommon","Rare","Elite","Legendary","Mythic","Godly"}) do
		local v = savedPrefs["SellRarity_" .. r]
		if v ~= nil then dropFarmState.sellRarities[r] = v end
	end

	dropFarmState.autoSell      = savedPrefs["AutoSell"]     or false
	dropFarmState.bagGamepass   = savedPrefs["BagGamepass"]  or false
	idolFarmState.serverhopping = savedPrefs["IdolServerhop"] or false

	-- restart farms
	if savedPrefs["ChestFarm"] then
		startLoop("chestfarm", doChestFarm)
		Window:Notify({ Title = "Chest Farm", Content = "Restored from save.", Duration = 3 })
	end
	if savedPrefs["DropFarm"] then
		startLoop("dropfarm", doDropFarm)
		Window:Notify({ Title = "Drop Farm", Content = "Restored from save.", Duration = 3 })
	end
	if savedPrefs["IdolFarm"] then
		startLoop("idolfarm", doIdolFarm)
		Window:Notify({ Title = "Idol Farm", Content = "Restored from save.", Duration = 3 })
	end
	if savedPrefs["LegendaryFarm"] then
		startLoop("legendaryfarm", doLegendaryFarm)
		Window:Notify({ Title = "Legendary Farm", Content = "Restored from save.", Duration = 3 })
	end
end

-- auto-login: clicks through menus automatically on every load/rejoin
task.spawn(function()
	local PG = LocalPlayer:WaitForChild("PlayerGui")

	local loginRunning = false
	local function doAutoLogin()
		if loginRunning then return end
		loginRunning = true
		print("[Astralite] Menu detected, waiting 5s then clicking through...")

		-- hide UI while in menu
		Window:SetVisible(false)
		task.wait(5)

		local endure = waitForVisible({"MainMenuGui","Frame","PlayButton"}, 15)
		if not endure then
			Window:SetVisible(true)
			restoreSession()
			loginRunning = false
			return
		end
		task.wait(0.5)
		autoClickButton(endure)

		local slot = waitForVisible({"SaveSlotsGui","Frame","ScrollingFrame","SaveSlot_" .. _activeSlot,"ButtonsFrame","PlayButton"}, 20)
		if not slot then
			-- fallback to slot 1
			slot = waitForVisible({"SaveSlotsGui","Frame","ScrollingFrame","SaveSlot_1","ButtonsFrame","PlayButton"}, 5)
			if not slot then
				Window:SetVisible(true)
				loginRunning = false
				return
			end
		end
		task.wait(0.5)
		autoClickButton(slot)

		-- wait for server list to populate (templates are ImageButtons)
		local server = nil
		local sDeadline = tick() + 20
		while tick() < sDeadline do
			local pg = LocalPlayer:WaitForChild("PlayerGui")
			local scrolling = pg:FindFirstChild("ServerMenuGui")
				and pg.ServerMenuGui:FindFirstChild("Frame")
				and pg.ServerMenuGui.Frame:FindFirstChild("MainFrame")
				and pg.ServerMenuGui.Frame.MainFrame:FindFirstChild("ScrollingFrame")
			if scrolling then
				local tmpl = scrolling:FindFirstChild("ServerMenuTemplate")
				if tmpl and tmpl:IsA("ImageButton") then
					server = tmpl
					break
				end
			end
			task.wait(0.3)
		end
		if not server then
			Window:SetVisible(true)
			loginRunning = false
			return
		end
		task.wait(0.5)
		-- fire connections directly since it's an ImageButton
		local conns = getconnections(server.MouseButton1Click)
		if conns and #conns > 0 then
			for _, c in ipairs(conns) do
				pcall(function() c.Fire() end)
			end
		else
			autoClickButton(server)
		end

		-- wait for world to load then show and restore
		task.wait(5)
		Window:SetVisible(true)
		Window:Notify({ Title = "Astralite", Content = "Auto-login complete.", Duration = 4 })
		restoreSession()
		loginRunning = false
	end

	-- watch for MainMenuGui visibility at any point
	local function watchMenu(mainMenu)
		if not mainMenu or not mainMenu:FindFirstChild("Frame") then return end
		-- already visible right now
		if mainMenu.Frame.Visible then
			task.spawn(doAutoLogin)
		end
		mainMenu.Frame:GetPropertyChangedSignal("Visible"):Connect(function()
			if mainMenu.Frame.Visible then
				task.spawn(doAutoLogin)
			end
		end)
	end

	-- check immediately
	task.wait(1)
	local mainMenu = PG:FindFirstChild("MainMenuGui")
	if mainMenu then
		if mainMenu:FindFirstChild("Frame") and mainMenu.Frame.Visible then
			task.spawn(doAutoLogin)
		else
			restoreSession()
		end
		watchMenu(mainMenu)
	else
		-- not in menu, already in game
		restoreSession()
		-- wait for it to appear later (after rejoin)
		local added = PG.ChildAdded:Connect(function(child)
			if child.Name == "MainMenuGui" then
				task.wait(0.5)
				watchMenu(child)
			end
		end)
	end
end)

